# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.eggs/
dist/
build/
.coverage
.coverage.*
htmlcov/

# ---- Node ----
node_modules/
.next/
.turbo/
out/
*.tsbuildinfo
.pnpm-store/

# ---- Environment ----
.env
.env.local
.env.*.local
# Keep example env files tracked
!.env.example

# ---- IntelliJ / JetBrains ----
.idea/
# Shared code style settings may be committed
!.idea/codeStyles/

# ---- VS Code ----
.vscode/
# Shared editor settings may be committed
!.vscode/settings.json

# ---- OS ----
.DS_Store
Thumbs.db
*.swp
*.swo

# ---- Logs ----
*.log
logs/

# ---- Local storage (uploaded documents) ----
# Anchored to the runtime upload locations so it does NOT match the
# backend/app/storage/ Python package (which is source code, not uploads).
/storage/
/backend/storage/
# Extraction-bench output now lives INSIDE storage (covered above); these cover the pre-fix sibling
# location so a prior run's borrower-derived output can never be committed.
/bench_output/
/backend/bench_output/
# A dev-chosen BENCH_OUTPUT_DIR inside the repo — borrower-derived output must never be committed.
/mortgageboss-batch-bench-out/

# ---- Databases ----
*.db
*.sqlite
*.sqlite3

# ---- PII artifacts (LP-210) ----
# Generated real-loan-file snapshot artifacts contain borrower NPI (names, DOB,
# financial profile) — never commit them. Generate locally for review only.
/docs/tickets/LP-210-*-snapshot.json

# ---- DB-sourced calibration worksheets (LP-379-D) ----
# write_db_worksheets() generates the calibration worksheet from a REAL DB loan file for a
# human labeling round — it carries real borrower PII (names, addresses). NEVER commit it.
# The generator's guard only writes outside the repo or under a calibration-local/ dir.
calibration-local/
