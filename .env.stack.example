# Root .env — consumed by Docker Compose variable interpolation ONLY.
# Distinct from backend/.env, which the worker loads via env_file.
# Leave absent in the main worktree to keep current names and ports.
#
# Copy to `.env` (repo root) in a SECONDARY worktree:
#   cp .env.stack.example .env
#
# With no root .env, docker-compose.yml resolves to its original values:
#   mortgageboss-postgres / -redis / -mailhog / -worker on 5432 / 6379 / 1025 / 8025.
#
# There are THREE .env files in play — do not confuse them:
#   .env (repo root)      Docker Compose interpolation  → STACK, host ports, project name
#   backend/.env          FastAPI settings + worker env_file → DB, Redis, CORS, keys
#   frontend/.env.local   Next.js → NEXT_PUBLIC_API_URL

COMPOSE_PROJECT_NAME=mbai-bedrock
STACK=mbai-bedrock
PG_PORT=5433
REDIS_PORT=6380
