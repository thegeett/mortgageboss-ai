#!/usr/bin/env bash
# Deployment CLI for a Terraform-managed environment under infra/envs/.
#
# The environment is an ARGUMENT. Nothing in this file names one: no account id,
# no region, no domain, no bucket, no cluster. Adding production means adding
# infra/envs/production/ with its own terraform.tfvars and an AWS profile -- not
# editing this script.
#
# Everything else is read back from `terraform output` (identifiers) or from the
# environment's own terraform.tfvars (account, region, domain, phase flags).
#
# Steps, order, and hazards come from docs/tickets/C5-deploy-staging.md.
#
# TARGETS BASH 3.2 (what macOS ships). See scripts/deploy-lib.sh.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
# shellcheck source=scripts/deploy-lib.sh
. "$SCRIPT_DIR/deploy-lib.sh"

STAGES="bootstrap phase1 dns images secrets migrate phase2 smoke all status bootstrap-admin add-user query-setup query deploy"

# How long `dns` waits for the registrar's delegation to propagate, and how long
# `migrate` waits for the one-off task to stop. Both overridable for a slow
# registrar or a cold Fargate start.
DNS_TIMEOUT_SECONDS="${DEPLOY_DNS_TIMEOUT_SECONDS:-1800}"
DNS_POLL_SECONDS="${DEPLOY_DNS_POLL_SECONDS:-30}"
MIGRATE_TIMEOUT_SECONDS="${DEPLOY_MIGRATE_TIMEOUT_SECONDS:-900}"

# How long `secrets` waits for an ElastiCache AUTH token rotation to become
# effective. Minutes, not seconds -- the cluster applies it node by node.
REDIS_AUTH_TIMEOUT_SECONDS="${DEPLOY_REDIS_AUTH_TIMEOUT_SECONDS:-900}"

# How long `deploy` waits for all three services to finish rolling. Generous: a
# rollout plus a circuit-breaker rollback is slower than a rollout alone, and
# exiting early would report success for something still failing.
DEPLOY_STEADY_TIMEOUT_SECONDS="${DEPLOY_STEADY_TIMEOUT_SECONDS:-900}"

# Network for the deploy stage's one-off tasks, resolved once from the running
# API service.
DEPLOY_SUBNETS=""
DEPLOY_SGS=""

usage() {
  cat <<'EOF'
deploy -- staged deployment driver for an infra/envs/<env> environment

USAGE
  ./scripts/deploy <env> <stage> [--yes] [--profile NAME] [--force]
  ./scripts/deploy --help

ARGUMENTS
  <env>     A directory name under infra/envs/. Never hardcoded -- adding an
            environment is a new tfvars file plus an AWS profile, not a code edit.
  <stage>   One of:

    bootstrap  terraform init + plan + apply in infra/bootstrap (the state bucket).
    phase1     terraform apply for the environment with TLS and Cognito OFF.
               Refuses if the plan contains an ACM certificate.
    dns        Prints the four nameservers and waits for the registrar delegation
               to go live. Applies nothing.
    images     ECR login, buildx both images for linux/arm64, push, then verify
               the pushed architecture.
    secrets    Populate all four Secrets Manager values. DATABASE_URL is derived
               from Terraform state and the Redis AUTH token is applied to the
               cluster, so nothing has to be extracted or pasted by hand. Every
               value is validated before writing. Refuses to overwrite without
               --force.
    migrate    Run the one-off Alembic task on ECS, tail its logs, fail on a
               non-zero exit code.
    phase2     Flip TLS + Cognito on and apply. Refuses unless DNS is delegated.
    smoke      The seven post-deploy checks, in order.
    all        Every stage in order, pausing at `dns` for the manual registrar
               step.
    status     Read-only. Prints the state of every stage. Safe at any time.

    bootstrap-admin
               Create the FIRST company and admin user. Prompts for the details
               and the password, hashes the password LOCALLY, and sends only the
               bcrypt hash. Refuses if the database already has any user.
    add-user   Add one user to an existing company, same mechanism. Refuses an
               unknown company slug or an email that is already taken.

    query-setup
               Create the mbai_readonly role and its grants. Run ONCE per
               environment, after migrate. Refuses any environment not listed in
               QUERY_ENVIRONMENTS -- the role does not exist in production and
               the migration deliberately does not create it.

    query      Run ONE read-only SELECT and print the result. Same one-off task
               mechanism. Connects as mbai_readonly, which has no privileges in
               schema public at all -- it sees only the readonly.* views, with
               PII dropped or scrubbed. Raw SSNs and TINs cannot come back this
               way. No confirmation prompt: it is read-only and meant to be run
               repeatedly, including by the agent.

                 ./scripts/deploy staging query path/to/file.sql
                 ./scripts/deploy staging query -c "select count(*) from loan_files"
                 ./scripts/deploy staging query -c "..." --max-rows 500

    deploy     Ship application code. Derives the image tag from git
               (<env>-<short sha>), refuses a dirty tree or a branch the
               environment's allowed_deploy_branches does not list, builds and
               pushes both images with OCI provenance labels, runs migrations
               BETWEEN the push and the service update but only when the deploy
               introduces any, writes the tag into terraform.tfvars, applies, and
               waits for all three services to finish rolling.

OPTIONS
  --yes            Answer every confirmation with yes. Still prints what it does.
  --profile NAME   AWS profile. Default: $AWS_PROFILE, else mbai-<env>-admin.
  --force          secrets only: overwrite a secret that already has a value.
  --allow-branch   deploy only: ship from a branch allowed_deploy_branches does
                   not list. The branch is still recorded in the image labels.
  --help, -h       This text.

EXIT CODES
  0  success
  1  a failure, a refusal, or an operator "no"
  2  smoke only: every automated check passed, but manual checks are unverified

ENVIRONMENT
  DEPLOY_DNS_TIMEOUT_SECONDS         default 1800
  DEPLOY_DNS_POLL_SECONDS            default 30
  DEPLOY_MIGRATE_TIMEOUT_SECONDS     default 900
  DEPLOY_REDIS_AUTH_TIMEOUT_SECONDS  default 900
  NO_COLOR                           disable colour

See docs/deployment-runbook.md for the full sequence and recovery steps.
EOF
}

# --------------------------------------------------------------------------- #
# Arguments
# --------------------------------------------------------------------------- #

ENV_NAME=""
STAGE=""
ASSUME_YES=0
FORCE=0
ALLOW_BRANCH=0
PROFILE_OVERRIDE=""
# query stage only: the SQL comes from a file (3rd positional) or -c. Never from argv of
# the TASK -- see stage_query.
QUERY_FILE=""
QUERY_SQL_INLINE=""
QUERY_MAX_ROWS=""

parse_args() {
  local positional=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help) usage; exit 0 ;;
      --yes | -y) ASSUME_YES=1 ;;
      --force) FORCE=1 ;;
      --allow-branch) ALLOW_BRANCH=1 ;;
      --profile)
        [ $# -ge 2 ] || die "--profile needs a value."
        PROFILE_OVERRIDE="$2"; shift ;;
      --profile=*) PROFILE_OVERRIDE="${1#*=}" ;;
      -c | --command)
        [ $# -ge 2 ] || die "-c needs a SQL string."
        QUERY_SQL_INLINE="$2"; shift ;;
      -c=* | --command=*) QUERY_SQL_INLINE="${1#*=}" ;;
      --max-rows)
        [ $# -ge 2 ] || die "--max-rows needs a value."
        QUERY_MAX_ROWS="$2"; shift ;;
      --max-rows=*) QUERY_MAX_ROWS="${1#*=}" ;;
      -*) die "Unknown option: $1" "Run ./scripts/deploy --help" ;;
      *)
        positional=$((positional + 1))
        if [ "$positional" = "1" ]; then ENV_NAME="$1"
        elif [ "$positional" = "2" ]; then STAGE="$1"
        elif [ "$positional" = "3" ] && [ "$STAGE" = "query" ]; then QUERY_FILE="$1"
        else die "Unexpected argument: $1" "Usage: ./scripts/deploy <env> <stage> [options]"
        fi ;;
    esac
    shift
  done

  if [ -z "$ENV_NAME" ] || [ -z "$STAGE" ]; then
    usage >&2
    die "Both <env> and <stage> are required."
  fi

  local found=0 s
  for s in $STAGES; do [ "$s" = "$STAGE" ] && found=1; done
  [ "$found" = "1" ] || die "Unknown stage: $STAGE" "Valid stages: $STAGES"
}

# --------------------------------------------------------------------------- #
# Environment resolution
#
# The three values every stage needs -- account, region, domain -- come from the
# environment's tfvars, because Terraform surfaces outputs and never inputs, and
# because the domain is needed by `images` (baked into the frontend bundle) long
# before the URL output means anything.
# --------------------------------------------------------------------------- #

ENV_DIR=""
TFVARS=""
ACCOUNT_ID=""
AWS_REGION=""
DOMAIN=""

resolve_env() {
  ENV_DIR=$(env_dir "$ENV_NAME")
  if [ ! -d "$ENV_DIR" ]; then
    die "No such environment: '$ENV_NAME' (looked for $ENV_DIR)" \
      "Available: $(list_envs | tr '\n' ' ')"
  fi
  TFVARS="$ENV_DIR/terraform.tfvars"
  [ -f "$TFVARS" ] || die "Environment '$ENV_NAME' has no terraform.tfvars ($TFVARS)."

  ACCOUNT_ID=$(tfvar_required "$TFVARS" "aws_account_id")
  AWS_REGION=$(tfvar_required "$TFVARS" "aws_region")
  # Optional: an environment with no DNS module has no domain, and only the
  # stages that need one complain.
  DOMAIN=$(tfvar "$TFVARS" "domain_name" || printf '')

  if [ -n "$PROFILE_OVERRIDE" ]; then
    AWS_PROFILE="$PROFILE_OVERRIDE"
  elif [ -n "${AWS_PROFILE:-}" ]; then
    : # inherit the caller's
  else
    # A convention, not a hardcoded environment: production resolves to
    # mbai-production-admin with no edit here.
    AWS_PROFILE="mbai-${ENV_NAME}-admin"
  fi
  export AWS_PROFILE
  # Terraform reads the same profile and region from the environment.
  export AWS_REGION
  export AWS_DEFAULT_REGION="$AWS_REGION"
}

require_domain() {
  [ -n "$DOMAIN" ] || die \
    "Environment '$ENV_NAME' has no \`domain_name\` in $TFVARS." \
    "This stage needs it. envs/dev has no DNS, TLS or Cognito module at all, so" \
    "this stage does not apply to it."
}

# --------------------------------------------------------------------------- #
# Temp files
# --------------------------------------------------------------------------- #

SECRET_TMPDIR=""

# Created on demand by every stage that writes a value to disk on its way to
# AWS. 0700, inside the run's own mktemp -d, removed by the exit trap even on
# Ctrl-C.
ensure_secret_tmpdir() {
  [ -n "$SECRET_TMPDIR" ] && [ -d "$SECRET_TMPDIR" ] && return 0
  SECRET_TMPDIR=$(mktemp -d "${TMPDIR:-/tmp}/deploy-secrets.XXXXXX")
  chmod 700 "$SECRET_TMPDIR"
}

cleanup() {
  if [ -n "${TF_OUTPUT_CACHE:-}" ]; then rm -f "$TF_OUTPUT_CACHE"; fi
  # The secret payload directory holds plaintext values on their way to Secrets
  # Manager. It must not survive the process, including on Ctrl-C.
  if [ -n "${SECRET_TMPDIR:-}" ] && [ -d "${SECRET_TMPDIR:-}" ]; then
    rm -rf "$SECRET_TMPDIR"
  fi
  # The deploy stage prints how to get back to the previous image if it did not
  # finish. In the trap rather than at each failure site so it also fires on
  # Ctrl-C and on a die() deep inside the apply.
  deploy_rollback_hint 2>/dev/null || true
  return 0
}
trap cleanup EXIT INT TERM

# --------------------------------------------------------------------------- #
# Stage: bootstrap
# --------------------------------------------------------------------------- #

stage_bootstrap() {
  banner "bootstrap -- state bucket ($ENV_NAME, account $ACCOUNT_ID)"
  need_cmd terraform; need_cmd aws; need_cmd jq
  require_identity "$ACCOUNT_ID"

  local dir plan rc
  dir=$(bootstrap_dir)
  plan="$dir/bootstrap.tfplan"

  note "Bootstrap uses LOCAL state -- it creates the bucket every other directory"
  note "stores its state in, so it cannot store its own state there."

  init_or_explain_lockfile "$dir" "bootstrap"

  set +e; tf_plan "$dir" "$plan"; rc=$?; set -e
  if [ "$rc" -eq 0 ]; then
    ok "bootstrap: no changes. The state bucket already exists and matches."
    rm -f "$plan"
    return 0
  fi

  hr
  hazard "The plan above is the FIRST thing that creates anything in $ACCOUNT_ID."
  info "The account guard is a Terraform precondition, so a wrong-account apply"
  info "fails the plan rather than warning."
  hr

  if ! confirm "Apply this bootstrap plan?"; then
    rm -f "$plan"
    die "Aborted by operator. Nothing was applied."
  fi

  would "terraform -chdir=$dir apply bootstrap.tfplan"
  tf "$dir" apply -input=false "$(basename "$plan")" || die "bootstrap apply failed."
  rm -f "$plan"
  ok "bootstrap applied."
}

# --------------------------------------------------------------------------- #
# Stage: phase1
# --------------------------------------------------------------------------- #

# The two flags move together. modules/compute/alb.tf has a guard that fails the
# plan on (cognito = true, tls = false), because an ALB cannot attach
# authenticate-cognito to an HTTP listener -- and that pair shipped once already,
# which meant the very first phase-1 plan could create nothing at all.
assert_phase_flags() {
  local want="$1" tls cognito
  tls=$(tfvar "$TFVARS" "enable_tls" || printf '')
  cognito=$(tfvar "$TFVARS" "enable_cognito" || printf '')
  [ -n "$tls" ] || die "\`enable_tls\` is not set in $TFVARS."
  [ -n "$cognito" ] || die "\`enable_cognito\` is not set in $TFVARS."

  if [ "$tls" != "$want" ] || [ "$cognito" != "$want" ]; then
    if [ "$want" = "false" ]; then
      die "phase1 needs enable_tls = false and enable_cognito = false; $TFVARS has tls=$tls cognito=$cognito." \
        "If this environment is already past phase 1, the stage you want is phase2." \
        "If you flipped them by hand and phase 1 never ran, set both back to false:" \
        "the ACM certificate cannot validate before the registrar delegation is live," \
        "and it will sit in PENDING_VALIDATION for its full 45-minute timeout."
    fi
    return 1
  fi
  return 0
}

stage_phase1() {
  banner "phase1 -- environment '$ENV_NAME' with TLS and Cognito OFF"
  need_cmd terraform; need_cmd aws; need_cmd jq
  require_identity "$ACCOUNT_ID"
  assert_phase_flags "false"

  local plan rc acm
  plan="$ENV_DIR/${ENV_NAME}.tfplan"

  init_or_explain_lockfile "$ENV_DIR" "$ENV_NAME"

  set +e; tf_plan "$ENV_DIR" "$plan"; rc=$?; set -e
  if [ "$rc" -eq 0 ]; then
    ok "phase1: no changes. This environment is already applied and matches."
    rm -f "$plan"
    return 0
  fi

  # The phase gate, checked against the PLAN rather than against the tfvars --
  # what matters is what would actually be created.
  acm=$(tf "$ENV_DIR" show -json "$(basename "$plan")" \
    | jq -r '[.resource_changes[]?
              | select(.type == "aws_acm_certificate")
              | select(.change.actions != ["no-op"])] | length') || die \
    "Could not read the saved plan back as JSON to check it for an ACM certificate." \
    "Refusing to apply an unchecked phase-1 plan: the whole point of this gate is" \
    "that a certificate created before DNS delegation hangs the apply for 45 minutes."
  if [ "$acm" != "0" ]; then
    rm -f "$plan"
    die "This phase-1 plan contains $acm aws_acm_certificate change(s)." \
      "Phase 1 must create no certificate. ACM validates over DNS, and until the" \
      "registrar delegation is live it sits in PENDING_VALIDATION until the apply" \
      "times out 45 minutes later." \
      "Set enable_tls = false and enable_cognito = false in $TFVARS, then re-run." \
      "The TLS listener and Cognito belong to the phase2 stage."
  fi
  ok "plan contains no ACM certificate."

  hr
  hazard "This is the point at which the environment becomes BILLABLE."
  info "Roughly 60 resources. The apply takes 10-15 minutes, mostly RDS."
  info "Expect the ECS services to start and their tasks to FAIL afterwards --"
  info "no images have been pushed yet. That is the expected state, not a fault."
  hr

  if ! confirm "Apply this phase-1 plan?"; then
    rm -f "$plan"
    die "Aborted by operator. Nothing was applied."
  fi

  would "terraform -chdir=$ENV_DIR apply $(basename "$plan")"
  tf "$ENV_DIR" apply -input=false "$(basename "$plan")" || die "phase1 apply failed." \
    "A partial apply is recoverable: re-running phase1 plans only the difference."
  rm -f "$plan"
  ok "phase1 applied."
}

# --------------------------------------------------------------------------- #
# Stage: dns -- waits, applies nothing
# --------------------------------------------------------------------------- #

stage_dns() {
  banner "dns -- registrar delegation for $ENV_NAME"
  need_cmd terraform; need_cmd jq; need_cmd dig
  require_domain
  require_outputs "$ENV_DIR"

  local count elapsed=0 parent
  parent="${DOMAIN#*.}"

  count=$(ns_awsdns_count "$DOMAIN")
  if [ "$count" -ge 4 ]; then
    ok "Delegation is already live: $count AWS nameservers answer for $DOMAIN."
    dig +short NS "$DOMAIN" | sed 's/^/       /'
    return 0
  fi

  hr
  info "${C_BOLD}MANUAL STEP -- this stage applies nothing.${C_RESET}"
  hr
  info "Add these FOUR NS records at the registrar for ${C_BOLD}${parent}${C_RESET}:"
  info ""
  info "  Type: NS     Host: ${C_BOLD}${DOMAIN%%.*}${C_RESET}     Value: (one record per line below)"
  info ""
  out_list route53_name_servers | sed 's/^/       /'
  info ""
  info "At Namecheap that is: Domain List -> ${parent} -> Manage -> Advanced DNS"
  info "-> Add New Record -> NS Record, four times, one nameserver each."
  hazard "The apex ${parent} stays at the registrar and is never delegated."
  info ""
  info "Waiting for delegation (poll every ${DNS_POLL_SECONDS}s, giving up after"
  info "${DNS_TIMEOUT_SECONDS}s). Ctrl-C is safe -- nothing here mutates anything."
  hr

  while [ "$elapsed" -lt "$DNS_TIMEOUT_SECONDS" ]; do
    sleep "$DNS_POLL_SECONDS"
    elapsed=$((elapsed + DNS_POLL_SECONDS))
    count=$(ns_awsdns_count "$DOMAIN")
    if [ "$count" -ge 4 ]; then
      ok "Delegation live after ${elapsed}s -- $count AWS nameservers answer for $DOMAIN."
      dig +short NS "$DOMAIN" | sed 's/^/       /'
      return 0
    fi
    note "  ${elapsed}s: $count/4 awsdns nameservers"
  done

  die "Delegation did not go live within ${DNS_TIMEOUT_SECONDS}s (last seen: $count/4)." \
    "Nothing was applied, and nothing is broken -- this stage only waits." \
    "Check at the registrar that all four NS records exist with host '${DOMAIN%%.*}'," \
    "then re-run:  ./scripts/deploy $ENV_NAME dns" \
    "Do NOT run phase2 until this is clean: ACM cannot validate without delegation."
}

# --------------------------------------------------------------------------- #
# Stage: images
# --------------------------------------------------------------------------- #

# An x86 image on an ARM64 task definition dies with `exec format error`, visible
# only in the CloudWatch log stream -- not in ECS service events, where it looks
# like a task that started and stopped for no reason.
verify_image_arch() {
  local uri="$1" inspect
  inspect=$(docker buildx imagetools inspect "$uri" 2>&1) || die \
    "Could not inspect $uri after pushing." "$inspect"
  if printf '%s' "$inspect" | grep -q 'linux/amd64'; then
    die "$uri contains a linux/amd64 manifest." \
      "The task definitions pin cpu_architecture = ARM64. An x86 image dies with" \
      "\`exec format error\`, and that message appears ONLY in the CloudWatch log" \
      "stream -- the ECS console shows a task that started and stopped." \
      "ECR tags are immutable, so fixing this means deleting the tag or bumping" \
      "image_tag in $TFVARS."
  fi
  printf '%s' "$inspect" | grep -q 'linux/arm64' || die \
    "$uri does not report a linux/arm64 platform." \
    "Refusing to leave an image of unverified architecture in front of an ARM64" \
    "task definition." \
    "docker buildx imagetools inspect said:" "$inspect"
  ok "architecture verified: linux/arm64"
}

# ECR repositories are IMMUTABLE-tagged (modules/registry/main.tf), so a re-push of
# the same tag is rejected by the registry. That makes "already pushed" the only
# possible idempotent behaviour: verify what is there and move on.
# What build_and_push suggests when the tag is already in ECR. The advice differs
# by caller: for `images` the answer is to bump image_tag, for `deploy` it is to
# make a commit, since the tag is a function of HEAD.
IMAGE_EXISTS_ADVICE=""

image_already_pushed() {
  local repo="$1" tag="$2"
  awsx ecr describe-images --repository-name "$repo" --image-ids "imageTag=$tag" \
    >/dev/null 2>&1
}

build_and_push() {
  local name="$1" uri="$2" context="$3"
  shift 3
  local repo tag
  repo=$(uri_repo "$uri"); tag=$(uri_tag "$uri")

  if image_already_pushed "$repo" "$tag"; then
    note "$name: $repo:$tag already exists in ECR."
    note "  Tags are IMMUTABLE, so this cannot be overwritten -- verifying instead."
    verify_image_arch "$uri"
    awsx ecr describe-images --repository-name "$repo" --image-ids "imageTag=$tag" \
      --query 'imageDetails[0].[imageDigest,imagePushedAt]' --output text \
      | sed 's/^/       /' || true
    info "  ${IMAGE_EXISTS_ADVICE:-To ship new bytes, bump \`image_tag\` in $TFVARS and re-run phase1 + images.}"
    return 0
  fi

  would "docker buildx build --platform linux/arm64 $* -t $uri --push $context"
  docker buildx build \
    --platform linux/arm64 \
    "$@" \
    -t "$uri" \
    --push \
    "$context" || die "$name: build/push failed." \
    "Nothing was pushed under this tag, so re-running is safe."
  ok "$name: pushed $uri"
  verify_image_arch "$uri"
}

stage_images() {
  banner "images -- build and push for $ENV_NAME"
  need_cmd docker; need_cmd aws; need_cmd jq; need_buildx
  require_domain
  require_identity "$ACCOUNT_ID"
  require_outputs "$ENV_DIR"

  local api_uri fe_uri registry
  api_uri=$(out_map container_image_uris api)
  fe_uri=$(out_map container_image_uris frontend)
  registry=$(uri_registry "$api_uri")

  info "Registry:  $registry"
  info "API:       $api_uri"
  info "Frontend:  $fe_uri"
  info ""

  hazard "The frontend's API URL is baked into the JavaScript bundle at BUILD time."
  info "NEXT_PUBLIC_API_URL is not read at runtime and cannot be set in the task"
  info "definition. Build it wrong and the browser calls the wrong host, with"
  info "nothing whatsoever in the server logs."
  info "This build uses: ${C_BOLD}https://${DOMAIN}${C_RESET}  (from domain_name in $TFVARS)"
  info ""
  note "The backend image must already carry the RDS CA bundle with PGSSLROOTCERT"
  note "pointing at it (backend/Dockerfile), or the database connection encrypts"
  note "without verifying anything."

  would "aws ecr get-login-password | docker login $registry"
  awsx ecr get-login-password | docker login --username AWS --password-stdin "$registry" \
    >/dev/null || die "ECR login failed for $registry."
  ok "logged in to $registry"

  build_and_push "api" "$api_uri" "$REPO_ROOT/backend"
  build_and_push "frontend" "$fe_uri" "$REPO_ROOT/frontend" \
    --build-arg "NEXT_PUBLIC_API_URL=https://${DOMAIN}"

  ok "images: both pushed and verified arm64."
}

# --------------------------------------------------------------------------- #
# Stage: secrets
# --------------------------------------------------------------------------- #

validate_database_url() {
  local url="$1"
  case "$url" in
    *sslmode=*)
      die "DATABASE_URL contains \`sslmode\`. Refusing to write it." \
        "SQLAlchemy's asyncpg dialect forwards unknown query parameters as raw kwargs" \
        "to asyncpg.connect(), which has no sslmode parameter and no **kwargs. The" \
        "app would fail to connect at all with:" \
        "  TypeError: connect() got an unexpected keyword argument 'sslmode'" \
        "The correct spelling is ?ssl=verify-full  (RDS documentation uses the libpq" \
        "spelling, which is wrong for this driver)." ;;
  esac
  case "$url" in
    *sslrootcert=*)
      die "DATABASE_URL contains \`sslrootcert\`. Refusing to write it." \
        "It fails exactly like sslmode does -- another unexpected kwarg. The CA path" \
        "reaches asyncpg through the PGSSLROOTCERT environment variable baked into" \
        "the image, never through the URL." ;;
  esac
  case "$url" in
    postgresql+asyncpg://*) ;;
    *) die "DATABASE_URL must start with postgresql+asyncpg:// -- got: ${url%%://*}://..." \
        "The application's engine is async; a bare postgresql:// URL selects psycopg2" \
        "and fails at startup." ;;
  esac
  case "$url" in
    *"?ssl="* | *"&ssl="*) ;;
    *) die "DATABASE_URL has no \`ssl=\` parameter. Refusing to write it." \
        "Over TCP with nothing specified asyncpg defaults to sslmode 'prefer', which" \
        "encrypts but sets CERT_NONE and no hostname check -- it connects happily and" \
        "silently gives up every guarantee the CA bundle exists to provide." \
        "Use ?ssl=verify-full" ;;
  esac
  case "$url" in
    *ssl=verify-full*) ;;
    *) warn "DATABASE_URL is not ssl=verify-full."
       warn "  ssl=require verifies the certificate chain (given PGSSLROOTCERT) but"
       warn "  NOT the hostname -- asyncpg gates check_hostname on verify-full alone."
       warn "  Accepted, but verify-full is what this environment should run." ;;
  esac
  case "$url" in
    *"<"*">"*) die "DATABASE_URL still contains a placeholder like <PASSWORD>." \
        "Fill in the real value -- the master password is deliberately not a Terraform" \
        "output, so it has to come from the console or from state." ;;
  esac
}

validate_redis_url() {
  local url="$1"
  case "$url" in
    rediss://*) ;;
    *) die "REDIS_URL must start with rediss:// -- got: ${url%%://*}://..." \
        "Transit encryption is unconditional on this cluster, so redis:// cannot" \
        "connect at all." ;;
  esac
  case "$url" in
    *ssl_cert_reqs=*) ;;
    *) die "REDIS_URL has no \`ssl_cert_reqs\` parameter. Refusing to write it." \
        "The two clients disagree on the default: redis-py (the cache) verifies," \
        "kombu (the Celery broker) resolves to CERT_NONE. Same URL, opposite posture." \
        "Use ?ssl_cert_reqs=required so both verify." ;;
  esac
  case "$url" in
    *"<"*">"*) die "REDIS_URL still contains a placeholder." \
        "The AUTH token is applied out of band and is not a Terraform output." ;;
  esac
}

# --------------------------------------------------------------------------- #
# DATABASE_URL derivation
#
# The RDS master password is deliberately NOT a Terraform output -- nothing
# surfaces it, so it cannot leak through `terraform output` or a CI log. It is
# nonetheless IN STATE, because a random_password always is, which is why the
# state bucket is encrypted, versioned and access-blocked.
#
# So the stage reads state directly rather than asking the operator to extract
# and paste a 32-character password. Pasting it was the actual failure mode:
# three attempts lost to terminal wrapping and clipboard handling, with the only
# symptom a validator rejection that could not say why.
#
# ⚠️ THE PASSWORD MUST NEVER REACH A TERMINAL, ARGV, OR A LOG.
#   * `terraform state pull` is piped straight into python -- no temp file.
#   * The extractor is passed with `-c`, which puts the PROGRAM in argv. That is
#     fine: the program is a fixed string with no secret in it, and the state
#     itself must stay on stdin. It cannot be a `- <<'HEREDOC'` instead -- the
#     heredoc would BECOME python's stdin and the piped state would never arrive,
#     which is exactly the bug the scratch harness caught here.
#   * The value lands in a shell variable, which is not visible in `ps` and is
#     not exported, so it is not in /proc/<pid>/environ.
#   * Display is built from PARTS with a literal `****`, never by substituting
#     the password out of the real URL -- a redaction that can fail open is not
#     a redaction.
#   * The write goes through put_secret, which uses a 0600 file and the printf
#     BUILTIN, so the value never becomes a process argument.
# --------------------------------------------------------------------------- #

# Prints the password on stdout for capture, or nothing and returns 1. Callers
# must not log the result. Deliberately silent on every failure path so the
# caller can fall back to prompting.
db_password_from_state() {
  local py="$1" pw
  set +x # defensive: never expand this under xtrace, whatever the caller did
  pw=$(tf "$ENV_DIR" state pull 2>/dev/null | "$py" -c '
import json, sys
try:
    state = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for res in state.get("resources", []):
    if res.get("type") == "random_password" and res.get("name") == "db":
        for inst in res.get("instances", []):
            value = inst.get("attributes", {}).get("result")
            if value:
                sys.stdout.write(value)
                sys.exit(0)
sys.exit(1)
') || return 1
  [ -n "$pw" ] || return 1
  printf '%s' "$pw"
}

# --------------------------------------------------------------------------- #
# Redis AUTH reconciliation
#
# Two different facts, easily confused, and the gap between them is silent:
#
#   redis_requires_auth_token  a TERRAFORM OUTPUT -- what the configuration was
#                              told to expect (var.redis_auth_enabled). It also
#                              decides whether the redis-url SECRET exists at all.
#   AuthTokenEnabled           what the REPLICATION GROUP actually has. The token
#                              is applied out of band, by hand, so this starts
#                              false and stays false until someone does it.
#
# Terraform cannot close the gap: an ElastiCache auth token is not something it
# manages here. So the stage reads the live value and refuses to write a secret
# that contradicts it -- because the contradiction does not fail here, it fails
# in the WORKER, as a NOAUTH authentication error with nothing pointing back at
# the secret.
# --------------------------------------------------------------------------- #

# Looked up by matching the PRIMARY ENDPOINT rather than by guessing the
# replication group id from name_prefix: the endpoint is already an output, and
# nothing then depends on a naming convention. Prints True, False, or empty when
# the group cannot be found.
redis_auth_token_enabled() {
  local endpoint="$1" v
  v=$(awsx elasticache describe-replication-groups \
    --query "ReplicationGroups[?NodeGroups[?PrimaryEndpoint.Address=='${endpoint}']].AuthTokenEnabled | [0]" \
    --output text 2>/dev/null) || { printf ''; return 0; }
  [ "$v" = "None" ] && { printf ''; return 0; }
  printf '%s' "$v"
}

redis_replication_group_id() {
  local endpoint="$1" v
  v=$(awsx elasticache describe-replication-groups \
    --query "ReplicationGroups[?NodeGroups[?PrimaryEndpoint.Address=='${endpoint}']].ReplicationGroupId | [0]" \
    --output text 2>/dev/null) || { printf ''; return 0; }
  [ "$v" = "None" ] && { printf ''; return 0; }
  printf '%s' "$v"
}

# The remediation text, printed by both failure paths.
redis_apply_token_instructions() {
  local endpoint="$1" rg
  rg=$(redis_replication_group_id "$endpoint")
  [ -n "$rg" ] || rg="<replication-group-id>"
  info ""
  info "  Apply the token (16-128 printable ASCII, no / \" @ or %):"
  info ""
  info "    TOKEN=\$(LC_ALL=C tr -dc 'A-Za-z0-9!*()-_=+.,;~' </dev/urandom | head -c 32)"
  info "    aws elasticache modify-replication-group \\"
  info "      --replication-group-id ${rg} \\"
  info "      --auth-token \"\$TOKEN\" \\"
  info "      --auth-token-update-strategy ROTATE \\"
  info "      --apply-immediately"
  info ""
  info "  ROTATE, not SET: the AWS CLI documents SET as \"allowed only after"
  info "  ROTATE\", and this group has no token yet. Wait for status 'available',"
  info "  confirm AuthTokenEnabled is true, then re-run this stage."
}

# Terraform's expectation vs the cluster's reality, checked BEFORE prompting so
# the operator is not asked for a value that cannot be written.
assert_redis_auth_agrees() {
  local needs_auth="$1" has_auth="$2" endpoint="$3"

  if [ -z "$has_auth" ]; then
    warn "Could not read AuthTokenEnabled for the cache at ${endpoint}."
    warn "  Proceeding without the cross-check -- verify by hand that the URL you"
    warn "  supply matches the cluster's actual auth state."
    return 0
  fi

  if [ "$needs_auth" = "true" ] && [ "$has_auth" != "True" ]; then
    hazard "TERRAFORM AND THE CLUSTER DISAGREE ABOUT REDIS AUTH."
    info ""
    info "  redis_requires_auth_token (terraform) : true"
    info "  AuthTokenEnabled (live cluster)       : ${has_auth}"
    info ""
    info "  The token is applied out of band and has not been applied. A"
    info "  token-bearing REDIS_URL written now would pass every check in this"
    info "  stage and then fail in the WORKER -- redis-py and kombu both raise an"
    info "  authentication error against a cluster that has no token, and nothing"
    info "  in that error points back at this secret."
    redis_apply_token_instructions "$endpoint"
    info ""
    info "  Alternatively, if this environment is genuinely not meant to use a"
    info "  token, set redis_auth_enabled = false in the tfvars and re-apply --"
    info "  that also removes the redis-url secret, and REDIS_URL becomes plain"
    info "  configuration in the task definition instead."
    die "Refusing to populate redis-url while the cluster has no AUTH token." \
      "Nothing was written. Apply the token, or change the configuration."
  fi

  if [ "$needs_auth" != "true" ] && [ "$has_auth" = "True" ]; then
    hazard "The cluster HAS an AUTH token, but this environment is configured without one."
    info "  A URL with no credential will be rejected by the cluster at connect time."
    info "  Supply the token in the URL, or remove it from the cluster."
  fi
  return 0
}

# --------------------------------------------------------------------------- #
# Applying a Redis AUTH token
#
# ⚠️ THIS MODIFIES A LIVE CLUSTER. It is gated on an explicit confirmation and
# runs only when the cluster has NO token yet.
# --------------------------------------------------------------------------- #

# The token alphabet is RFC 3986 UNRESERVED characters only: ALPHA / DIGIT /
# "-" / "." / "_" / "~".
#
# That satisfies three constraints at once rather than just the AWS one:
#   * ElastiCache forbids '/', '"', '@' and '%' -- none are here.
#   * None is special to a shell, so the value cannot be mangled by quoting.
#   * Unreserved characters need NO percent-encoding in a URL userinfo, so the
#     token drops into rediss://:TOKEN@host verbatim. This is the same reasoning
#     that shaped the RDS password's override_special set, and it removes
#     encoding as a category of error.
#
# 32 characters over a 66-character alphabet is about 193 bits. The program is
# fed to python on STDIN, not with -c, so it never appears in argv.
generate_redis_auth_token() {
  "$1" - <<'PY'
import secrets, string
alphabet = string.ascii_letters + string.digits + "-._~"
sys_out = "".join(secrets.choice(alphabet) for _ in range(32))
print(sys_out, end="")
PY
}

# Set by apply_redis_auth_token. A GLOBAL rather than a stdout capture on
# purpose: a function whose value is captured through $( ) must keep every
# progress line off stdout, and getting that wrong is exactly the bug that made
# this stage unusable in the first place. Progress here is genuinely useful --
# the modify takes minutes -- so the value travels out of band instead.
REDIS_AUTH_TOKEN=""

apply_redis_auth_token() {
  local py="$1" endpoint="$2" rg="$3"
  local token f elapsed=0 status auth
  REDIS_AUTH_TOKEN=""

  token=$(generate_redis_auth_token "$py") || die "Could not generate an AUTH token."
  if [ "${#token}" -ne 32 ]; then
    die "Generated AUTH token is ${#token} characters, expected 32." \
      "Nothing was changed."
  fi

  # ⚠️ --cli-input-json, NOT --auth-token on the command line. A token passed as
  # an argument is visible in `ps` to every user on the machine for as long as
  # the call runs. The file is 0600 inside the run's own temp directory and is
  # removed immediately; the exit trap removes the directory even on Ctrl-C.
  f="$SECRET_TMPDIR/redis-auth.$$.json"
  (
    umask 077
    printf '{"ReplicationGroupId":"%s","AuthToken":"%s","AuthTokenUpdateStrategy":"ROTATE","ApplyImmediately":true}\n' \
      "$rg" "$token" >"$f"
  )

  would "aws elasticache modify-replication-group --replication-group-id $rg \\"
  would "  --auth-token <generated> --auth-token-update-strategy ROTATE --apply-immediately"
  if ! awsx elasticache modify-replication-group --cli-input-json "file://$f" >/dev/null 2>&1; then
    rm -f "$f"
    die "modify-replication-group failed for $rg." \
      "Nothing was written to Secrets Manager. Re-run once the cause is fixed;" \
      "if the token WAS applied despite the error, this stage will detect it and" \
      "fall back to prompting, because it will not rotate a token it does not know."
  fi
  rm -f "$f"
  ok "token submitted; the cluster is now applying it"

  info "  Waiting for status=available AND AuthTokenEnabled=true."
  info "  This takes minutes. Ctrl-C is safe here -- the modify is already"
  info "  submitted, and re-running the stage picks up from whatever state the"
  info "  cluster reaches."

  while [ "$elapsed" -lt "$REDIS_AUTH_TIMEOUT_SECONDS" ]; do
    status=$(awsx elasticache describe-replication-groups \
      --query "ReplicationGroups[?NodeGroups[?PrimaryEndpoint.Address=='${endpoint}']].Status | [0]" \
      --output text 2>/dev/null || printf 'unknown')
    auth=$(redis_auth_token_enabled "$endpoint")
    if [ "$status" = "available" ] && [ "$auth" = "True" ]; then
      ok "AUTH token active after ${elapsed}s (status=$status, AuthTokenEnabled=$auth)"
      REDIS_AUTH_TOKEN="$token"
      return 0
    fi
    note "  ${elapsed}s: status=${status:-?} AuthTokenEnabled=${auth:-?}"
    sleep 15
    elapsed=$((elapsed + 15))
  done

  die "The cluster did not reach status=available with AuthTokenEnabled=true within ${REDIS_AUTH_TIMEOUT_SECONDS}s." \
    "Last seen: status=${status:-?} AuthTokenEnabled=${auth:-?}" \
    "The token WAS submitted, so it may still be applying -- but this run does not" \
    "know whether it took effect, and it will not write a URL it cannot verify." \
    "Nothing was written to Secrets Manager." \
    "" \
    "⚠️ The generated token is now DISCARDED. If the rotation did complete, the" \
    "cluster holds a token nobody knows, and the only way forward is another" \
    "rotation -- re-run this stage once the cluster is available and it will" \
    "detect the existing token and ask you to supply the URL instead." \
    "Raise DEPLOY_REDIS_AUTH_TIMEOUT_SECONDS if the cluster is simply slow."
}

# Does a rediss:// URL carry a credential? Userinfo is whatever precedes '@'
# inside the authority, so the path and query are stripped before looking.
redis_url_has_credential() {
  local rest="${1#*://}"
  rest="${rest%%/*}"
  rest="${rest%%\?*}"
  case "$rest" in
    *@*) return 0 ;;
    *) return 1 ;;
  esac
}

# The refusal the report asked for, applied to the value actually supplied --
# the operator can always paste something other than the suggestion.
assert_redis_credential_matches() {
  local url="$1" has_auth="$2" endpoint="$3"
  [ -n "$has_auth" ] || return 0

  if [ "$has_auth" != "True" ] && redis_url_has_credential "$url"; then
    hazard "This REDIS_URL carries a credential; the cluster has NO auth token."
    info ""
    info "  AuthTokenEnabled is ${has_auth} on the cache at ${endpoint}."
    info "  Redis rejects AUTH against a server with no password configured, so"
    info "  every cache read and every Celery broker operation would fail -- in"
    info "  the worker, at runtime, not here."
    redis_apply_token_instructions "$endpoint"
    die "Refusing to write a token-bearing REDIS_URL to a cluster with no token." \
      "Nothing was written."
  fi

  if [ "$has_auth" = "True" ] && ! redis_url_has_credential "$url"; then
    hazard "This REDIS_URL carries no credential; the cluster REQUIRES one."
    info ""
    info "  AuthTokenEnabled is True on the cache at ${endpoint}. An"
    info "  unauthenticated client is refused with NOAUTH at connect time."
    info "  The shape is  rediss://:TOKEN@host:6379/0?ssl_cert_reqs=required"
    info "  -- empty username, colon immediately after the slashes."
    die "Refusing to write an unauthenticated REDIS_URL to a cluster that requires auth." \
      "Nothing was written."
  fi
  return 0
}

# Prompt with a suggestion printed above the prompt.
prompt_with_suggestion() {
  local label="$1" suggestion="$2" value

  # ⚠️ EVERY PROMPT BYTE GOES TO STDERR, and that is load-bearing.
  #
  # The caller reads this function through a command substitution
  # (`url=$(prompt_with_suggestion ...)`), which captures STDOUT. With the prompt
  # on stdout the operator saw NOTHING — the whole prompt was swallowed into the
  # variable and the typed value was appended to it, so validation rejected 260
  # bytes of prompt text followed by a perfectly good URL. The reported symptom
  # was "it rejects the DATABASE_URL I paste", with `got:` printing empty.
  #
  # Only the value below may reach stdout.
  {
    info ""
    info "  ${C_BOLD}${label}${C_RESET}"
    info "  suggested (from terraform output):"
    info "    ${suggestion}"
    info "  Press Enter to accept, or paste the corrected value."
    printf '  %s> ' "$label"
  } >&2

  # -e for readline, so a 130-character URL can be edited rather than only
  # retyped. bash 3.2 has no `read -i`, so the suggestion still cannot be
  # pre-loaded into the line editor; pressing Enter accepts it verbatim, which
  # for a value still containing <PASSWORD> fails validation rather than writing
  # something broken. With non-terminal stdin `-e` degrades to a plain read
  # (verified), so piping input still works.
  read -r -e value
  [ -z "$value" ] && value="$suggestion"
  printf '%s' "$value"
}

stage_secrets() {
  banner "secrets -- populate Secrets Manager for $ENV_NAME"
  need_cmd aws; need_cmd jq; need_cmd terraform
  require_identity "$ACCOUNT_ID"
  require_outputs "$ENV_DIR"

  ensure_secret_tmpdir

  local py fernet_py names key id existing wrote_fernet=""
  py=$(command -v python3 || true)
  [ -n "$py" ] || die "python3 not found -- needed to generate the JWT secret."
  fernet_py=$(require_fernet_python)
  note "fernet/validation python: $fernet_py"

  names=$(jq -r '.secret_names.value | keys[]' "$TF_OUTPUT_CACHE") || die \
    "The secret_names output is missing or not a map."

  info ""
  info "Terraform creates these as EMPTY containers. A task whose secret is empty"
  info "fails to start, so every one of them has to be filled before migrate."
  info ""
  info "Secrets in this environment: $(printf '%s' "$names" | tr '\n' ' ')"

  for key in $names; do
    id=$(out_map secret_names "$key")
    existing=$(secret_len "$id")

    if [ -n "$existing" ]; then
      if [ "$FORCE" != "1" ]; then
        note "skip  $key ($id) -- already has a value, $existing bytes"
        continue
      fi
      hazard "--force: about to OVERWRITE $key, which already holds $existing bytes."
      if [ "$key" = "encryption-key" ]; then
        hazard "encryption-key is single-key Fernet with NO re-encryption path until B2."
        info "  Overwriting it makes every SSN already stored in this environment"
        info "  permanently undecryptable. There is no recovery."
      fi
      confirm "  Overwrite $key?" || { note "skip  $key -- declined"; continue; }
    fi

    case "$key" in
      jwt-secret-key)
        would "put-secret-value $id  (generated, 48 random bytes urlsafe)"
        put_secret "$id" "$("$py" -c 'import secrets;print(secrets.token_urlsafe(48),end="")')"
        ok "$key written" ;;

      encryption-key)
        local fkey
        fkey=$("$fernet_py" -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode(),end="")')
        # Construct one from the generated value before writing it: a length check
        # would accept values Fernet rejects at the first SSN write, inside a
        # request handler.
        # ⚠️ The key goes in on STDIN, not as an argument. `sys.argv[1]` put the
        # encryption key in the process's command line, where `ps` shows it to
        # every user on the machine for the life of the call. printf is a shell
        # builtin, so the value never becomes a process argument at all.
        printf '%s' "$fkey" \
          | "$fernet_py" -c 'import sys;from cryptography.fernet import Fernet;Fernet(sys.stdin.read())' \
          || die "Generated encryption-key did not construct as a Fernet key." \
            "Nothing was written."
        would "put-secret-value $id  (generated Fernet key, validated by construction)"
        put_secret "$id" "$fkey"
        wrote_fernet="$fkey"
        ok "$key written and validated" ;;

      database-url)
        local host db user suggestion url redacted pw
        host=$(out rds_address); db=$(out rds_database_name); user=$(out rds_username)
        suggestion="postgresql+asyncpg://${user}:<PASSWORD>@${host}:5432/${db}?ssl=verify-full"
        url=""

        pw=$(db_password_from_state "$py") || pw=""

        if [ -n "$pw" ]; then
          # Built from parts, so the displayed string never contains the
          # password at any point -- there is nothing to redact and therefore
          # nothing that can fail to be redacted.
          redacted="postgresql+asyncpg://${user}:****@${host}:5432/${db}?ssl=verify-full"
          info ""
          info "  Derived from Terraform state -- nothing to paste:"
          info ""
          info "    ${redacted}"
          info ""
          note "  Password read from module.data.random_password.db (${#pw} characters)."
          note "  It is never displayed, never placed on a command line, and is written"
          note "  through a 0600 file that this run deletes."
          if confirm_default_yes "  Use this DATABASE_URL?"; then
            url="postgresql+asyncpg://${user}:${pw}@${host}:5432/${db}?ssl=verify-full"
          else
            note "  Falling back to entering it by hand."
          fi
        else
          info ""
          hazard "Could not read the master password from Terraform state."
          info "  The state read failed, or this environment's state has no"
          info "  module.data.random_password.db. Falling back to entering the URL."
          info "  The password is deliberately NOT a Terraform output, so take it from"
          info "  the RDS console or from state by hand."
        fi

        [ -n "$url" ] || url=$(prompt_with_suggestion "DATABASE_URL" "$suggestion")
        validate_database_url "$url"
        would "put-secret-value $id  (validated: asyncpg spelling, ssl parameter present)"
        put_secret "$id" "$url"
        url=""; pw=""
        ok "$key written" ;;

      redis-url)
        local endpoint scheme suggestion rurl needs_auth has_auth
        endpoint=$(out redis_primary_endpoint)

        # ⚠️ The output is the BARE scheme -- `rediss`, not `rediss://`
        # (modules/data/outputs.tf). This once concatenated as though the
        # separator were included, producing `rediss:<TOKEN>@host` (no slashes)
        # and, on the no-auth path, `redissmaster.mbai-...` with the scheme fused
        # to the hostname. Both were rejected by the validator, so the suggested
        # value could never be accepted by pressing Enter.
        #
        # Trailing `://` is stripped first so either spelling of the output
        # works, now and if it ever changes.
        scheme=$(out_opt redis_url_scheme); [ -n "$scheme" ] || scheme="rediss"
        scheme="${scheme%://}"

        needs_auth=$(out_opt redis_requires_auth_token)
        has_auth=$(redis_auth_token_enabled "$endpoint")
        rurl=""

        if [ "$needs_auth" = "true" ] && [ "$has_auth" = "False" ]; then
          # The cluster needs a token and has none. Rather than refusing and
          # sending the operator away to run the command by hand, apply it here
          # and build the URL from the token in the SAME RUN -- which is the only
          # arrangement in which the token never has to be displayed, copied, or
          # stored anywhere but Secrets Manager.
          local rg
          rg=$(redis_replication_group_id "$endpoint")
          [ -n "$rg" ] || die \
            "Could not resolve the replication group id for ${endpoint}." \
            "Nothing was changed."

          info ""
          hazard "THIS MODIFIES A LIVE CLUSTER."
          info ""
          info "  replication group : ${C_BOLD}${rg}${C_RESET}"
          info "  endpoint          : ${endpoint}"
          info "  AuthTokenEnabled  : False  ->  true"
          info ""
          info "  A 32-character token will be generated, applied with"
          info "  --auth-token-update-strategy ROTATE (SET is rejected until a"
          info "  rotation has occurred, and this group has never had one), and used"
          info "  to build REDIS_URL immediately."
          info ""
          info "  The token is never printed. It exists in this process and in the"
          info "  redis-url secret, and nowhere else -- so if the write fails, the"
          info "  recovery is another rotation, not a lookup."
          info ""
          note "  Existing connections are not interrupted by adding a token, but"
          note "  anything already using this cache without one will start failing"
          note "  authentication once it is active. Nothing runs yet in this"
          note "  environment -- no images are deployed."

          if ! confirm "  Apply an AUTH token to ${rg} now?"; then
            info ""
            info "  Declined. To do it by hand instead:"
            redis_apply_token_instructions "$endpoint"
            die "Refusing to populate redis-url while the cluster has no AUTH token." \
              "Nothing was changed and nothing was written."
          fi

          apply_redis_auth_token "$py" "$endpoint" "$rg"
          rurl="${scheme}://:${REDIS_AUTH_TOKEN}@${endpoint}:6379/0?ssl_cert_reqs=required"
          has_auth="True"
          info ""
          info "  REDIS_URL built from the token just applied:"
          info "    ${scheme}://:****@${endpoint}:6379/0?ssl_cert_reqs=required"

        elif [ "$needs_auth" != "true" ] && [ "$has_auth" = "False" ]; then
          # No token wanted, none present: the URL carries no credential and is
          # fully derivable.
          rurl="${scheme}://${endpoint}:6379/0?ssl_cert_reqs=required"
          info ""
          info "  Derived -- this cache has no AUTH token, so the URL carries no"
          info "  credential:"
          info "    ${rurl}"
          confirm_default_yes "  Use this REDIS_URL?" || rurl=""

        else
          # Two remaining cases, both of which must NOT rotate:
          #   has_auth=True  -- a token exists and this script does not know it.
          #                     Rotating would break every consumer already using
          #                     it, so the operator supplies the URL.
          #   has_auth=""    -- the cluster could not be read at all.
          assert_redis_auth_agrees "$needs_auth" "$has_auth" "$endpoint"
          if [ "$has_auth" = "True" ]; then
            info ""
            hazard "This cluster ALREADY has an AUTH token, so nothing is rotated here."
            info "  The existing token is not knowable from Terraform state or from any"
            info "  API -- ElastiCache never returns it. Rotating to a token this script"
            info "  generated would silently break every consumer still using the old"
            info "  one, so the URL has to be supplied."
            info "  Shape: ${scheme}://:TOKEN@${endpoint}:6379/0?ssl_cert_reqs=required"
            info "  -- empty username, colon immediately after the slashes."
          fi
        fi

        if [ -z "$rurl" ]; then
          if [ "$has_auth" = "True" ]; then
            suggestion="${scheme}://:<AUTH_TOKEN>@${endpoint}:6379/0?ssl_cert_reqs=required"
          else
            suggestion="${scheme}://${endpoint}:6379/0?ssl_cert_reqs=required"
          fi
          rurl=$(prompt_with_suggestion "REDIS_URL" "$suggestion")
        fi

        validate_redis_url "$rurl"
        assert_redis_credential_matches "$rurl" "$has_auth" "$endpoint"
        would "put-secret-value $id  (validated: rediss scheme, ssl_cert_reqs, credential matches cluster)"
        put_secret "$id" "$rurl"
        rurl=""; REDIS_AUTH_TOKEN=""
        ok "$key written" ;;

      *)
        warn "No generator for secret '$key' -- this script does not know it."
        warn "  Populate it by hand, then re-run: ./scripts/deploy $ENV_NAME status" ;;
    esac
  done

  # The one value that is printed. It is generated here, cannot be read back
  # meaningfully once it starts encrypting, and cannot be rotated at all.
  if [ -n "$wrote_fernet" ]; then
    info ""
    hr
    hazard "ENCRYPTION KEY -- PRINTED ONCE, HERE, AND NOWHERE ELSE."
    info ""
    info "    ${C_BOLD}${wrote_fernet}${C_RESET}"
    info ""
    info "Store it in a password manager OUTSIDE this AWS account, now."
    info "Until B2 lands there is no rotation path: single-key Fernet with no"
    info "re-encryption. Losing it means losing every stored SSN. Having it leak"
    info "means choosing between leaving it in place and destroying the same data."
    hr
    if [ "${ASSUME_YES:-0}" != "1" ] && [ -t 0 ]; then
      printf '%sPress Enter once it is saved.%s ' "$C_BOLD" "$C_RESET"
      read -r _
    fi
  fi

  banner "secrets -- verification"
  local failed=0 len
  for key in $names; do
    id=$(out_map secret_names "$key")
    len=$(secret_len "$id")
    if [ -z "$len" ]; then
      bad "$(printf '%-18s' "$key") EMPTY -- a task with this secret cannot start"
      failed=1
    else
      ok "$(printf '%-18s' "$key") $len bytes"
    fi
  done
  [ "$failed" = "0" ] || die "One or more secrets are still empty." \
    "Re-run this stage, or populate the remainder by hand."
  ok "all secrets non-empty."
}

# --------------------------------------------------------------------------- #
# Stage: migrate
# --------------------------------------------------------------------------- #

stage_migrate() {
  banner "migrate -- Alembic upgrade head on ECS ($ENV_NAME)"
  need_cmd aws; need_cmd jq; need_cmd terraform
  require_identity "$ACCOUNT_ID"
  require_outputs "$ENV_DIR"

  local cluster taskdef subnets sgs netcfg arn task_id status exit_code elapsed=0
  cluster=$(out ecs_cluster_name)
  taskdef=$(out_map ecs_task_definition_arns migrate)

  # Read the network configuration off the running API service rather than from
  # the raw subnet list: tasks are pinned to the AZs that have interface
  # endpoints, and the private_subnet_ids output includes AZs that do not. A task
  # in the wrong AZ still resolves the endpoints VPC-wide, but pays cross-AZ
  # transfer for every AWS call it makes.
  local api_svc
  api_svc=$(out_map ecs_service_names api)
  netcfg=$(awsx ecs describe-services --cluster "$cluster" --services "$api_svc" \
    --query 'services[0].networkConfiguration.awsvpcConfiguration.[join(`,`,subnets),join(`,`,securityGroups)]' \
    --output text 2>/dev/null || printf '')
  if [ -n "$netcfg" ] && [ "$netcfg" != "None	None" ]; then
    subnets=$(printf '%s' "$netcfg" | awk -F'\t' '{print $1}')
    sgs=$(printf '%s' "$netcfg" | awk -F'\t' '{print $2}')
    note "network: taken from the running '$api_svc' service, so the task lands in"
    note "         the same subnets the endpoints are in."
  else
    subnets=$(out_list_first private_subnet_ids)
    sgs=$(out ecs_tasks_security_group_id)
    warn "Could not read the API service's network configuration; falling back to"
    warn "  the first private subnet from terraform output. If that AZ has no"
    warn "  interface endpoints the task still works, but every AWS call is cross-AZ."
  fi

  info "cluster:  $cluster"
  info "taskdef:  $taskdef"
  info "subnets:  $subnets"
  info "sg:       $sgs"
  info ""
  note "alembic upgrade head is idempotent -- against an already-migrated database"
  note "it reports 'no upgrades' and exits 0, so re-running this stage is safe."

  would "aws ecs run-task --cluster $cluster --task-definition $taskdef --launch-type FARGATE"
  arn=$(awsx ecs run-task \
    --cluster "$cluster" \
    --task-definition "$taskdef" \
    --launch-type FARGATE \
    --network-configuration "awsvpcConfiguration={subnets=[$subnets],securityGroups=[$sgs],assignPublicIp=DISABLED}" \
    --query 'tasks[0].taskArn' --output text) || die "run-task failed."

  if [ -z "$arn" ] || [ "$arn" = "None" ]; then
    die "run-task returned no task ARN." \
      "Check the failures[] entry in the API response -- the usual causes are a" \
      "capacity problem or a subnet/security-group that does not exist."
  fi
  task_id="${arn##*/}"
  ok "task started: $task_id"

  while [ "$elapsed" -lt "$MIGRATE_TIMEOUT_SECONDS" ]; do
    status=$(awsx ecs describe-tasks --cluster "$cluster" --tasks "$arn" \
      --query 'tasks[0].lastStatus' --output text 2>/dev/null || printf 'UNKNOWN')
    [ "$status" = "STOPPED" ] && break
    note "  ${elapsed}s: $status"
    sleep 10
    elapsed=$((elapsed + 10))
  done

  if [ "$status" != "STOPPED" ]; then
    die "Migration task did not stop within ${MIGRATE_TIMEOUT_SECONDS}s (last status: $status)." \
      "A task stuck in PENDING is almost always an image pull: check that the ECR" \
      "endpoint exists and that the tag is really in the repository." \
      "Task: $arn"
  fi

  # Logs before the verdict: when the exit code is non-zero the log IS the reason,
  # and with ECS Exec off there is no second way to get it.
  # The stream name is derived from THIS task's id, so it cannot silently show a
  # different run's output: either the stream matches the task, or the fetch
  # fails and says so. Worth stating because a stale log is the first thing
  # suspected when two runs produce the same traceback.
  local group stream
  group=$(log_group_for api)
  stream="migrate/migrate/${task_id}"
  hr
  info "CloudWatch logs -- $group : $stream"
  hr
  awsx logs get-log-events --log-group-name "$group" --log-stream-name "$stream" \
    --start-from-head --query 'events[].message' --output text 2>/dev/null \
    | tr '\t' '\n' | sed 's/^/  /' \
    || warn "No log stream for this task. The container died before it logged anything: an empty secret, an architecture mismatch, and the uv-run PyPI hang all look identical here. With ECS Exec off, the fastest diagnosis is running the same image locally with the same environment."
  hr

  exit_code=$(awsx ecs describe-tasks --cluster "$cluster" --tasks "$arn" \
    --query 'tasks[0].containers[0].exitCode' --output text 2>/dev/null || printf 'None')
  local stopped_reason
  stopped_reason=$(awsx ecs describe-tasks --cluster "$cluster" --tasks "$arn" \
    --query 'tasks[0].stoppedReason' --output text 2>/dev/null || printf '')

  if [ "$exit_code" = "0" ]; then
    ok "migration exited 0. The database is at head."
    return 0
  fi
  die "Migration task exited with code '$exit_code'." \
    "stoppedReason: ${stopped_reason:-(none)}" \
    "The logs above are the reason. An empty log section means the container died" \
    "before logging: an empty secret, an architecture mismatch, and the uv-run" \
    "PyPI hang all look identical from the console." \
    "Nothing else has been changed -- fix the cause and re-run this stage."
}

# --------------------------------------------------------------------------- #
# Account provisioning -- bootstrap-admin and add-user
#
# There is no registration route in this application: no signup endpoint, no
# users router, no password-reset flow. Accounts are made by a deliberate act,
# and these two stages are it.
#
# ⚠️ THE PASSWORD IS HASHED ON THIS MACHINE AND NEVER SENT.
#
# Both stages run a one-off ECS task whose values arrive through
# `run-task --overrides`. Those are visible in `describe-tasks` for about an
# hour and are recorded in the CloudTrail RunTask event. A bcrypt hash at cost
# 12 with a random salt is not meaningfully sensitive in either place; a
# plaintext password would be. So scripts/hash-password produces the hash
# locally, and only the hash leaves the machine.
#
# ⚠️ AND THE HASH STILL DOES NOT REACH ARGV. The whole run-task request is built
# with jq reading from the ENVIRONMENT (`env.NAME`, never `--arg`) into a 0600
# file, and passed as `--cli-input-json file://…`. `ps` shows a process's full
# command line to every user on the machine; it does not show its environment.
# --------------------------------------------------------------------------- #

# Prompt for one value. The prompt goes to STDERR so `x=$(ask …)` captures the
# answer and nothing else -- the same mistake that made the secrets stage
# unusable, not repeated here.
ask() {
  local label="$1" default="${2:-}" reply
  if [ -n "$default" ]; then
    printf '  %s [%s]: ' "$label" "$default" >&2
  else
    printf '  %s: ' "$label" >&2
  fi
  if [ ! -t 0 ]; then
    die "Cannot prompt: stdin is not a terminal." \
      "These stages are interactive by design -- they take a password."
  fi
  read -r reply
  [ -z "$reply" ] && reply="$default"
  printf '%s' "$reply"
}

ask_required() {
  local value
  value=$(ask "$@")
  [ -n "$value" ] || die "'$1' is required and cannot be empty." "Nothing was run."
  printf '%s' "$value"
}

# ⚠️ Both provisioning stages refuse without Cognito. An application login that
# is not behind the ALB's authentication wall is a state worth refusing to
# create: the account being made is an ADMIN in an environment that holds real
# borrower files.
#
# ⚠️ This reads an APPLIED OUTPUT, not terraform.tfvars. The tfvars value is what
# the operator intends to apply, which is not the same question. Editing
# `enable_cognito = false` -> `true` and running this stage before `phase2` would
# satisfy a tfvars check while the load balancer still has no authenticate-cognito
# action on it -- the exact open door the refusal below describes.
# `cognito_user_pool_id` is `var.enable_cognito ? ...[0].id : null` in the compute
# module, so a non-empty value means the pool, and with it the listener rule
# gated on the same variable, is really out there. Callers must run
# require_outputs first.
require_cognito_enabled() {
  local pool intent
  pool=$(out_opt cognito_user_pool_id)
  [ -n "$pool" ] && return 0
  intent=$(tfvar "$TFVARS" "enable_cognito" || printf '')
  die "Refusing: environment '$ENV_NAME' has no applied Cognito user pool." \
    "enable_cognito is '${intent:-unset}' in $TFVARS, but that is the value you mean" \
    "to apply -- the load balancer is what it is until phase2 runs." \
    "This stage creates an account that can log in to the application. Without" \
    "Cognito on the load balancer there is no authentication in front of it, and" \
    "an admin account in an environment holding borrower files is not something to" \
    "create into an open door." \
    "Run:  ./scripts/deploy $ENV_NAME phase2"
}

# ⚠️ Where account provisioning is permitted, as a FIXED list -- deliberately not
# "$ENV_NAME". Passing the target back to the container's own allowlist would
# make the guard tautological: `./scripts/deploy production bootstrap-admin`
# would set the allowlist to `production` and then pass it. The value below is
# what the container checks its ENVIRONMENT against, so the two have to disagree
# for the check to mean anything.
PROVISIONING_ENVIRONMENTS="staging"

# Environments the read-only `query` stage may run against (C7). SEPARATE from
# PROVISIONING_ENVIRONMENTS so widening one never silently widens the other. Production is
# deliberately absent: this path returns loan data to a terminal and a transcript, and the
# masked views make that survivable in staging, not appropriate everywhere.
QUERY_ENVIRONMENTS="staging"

# Refuse here as well as in the container, so an unintended target dies before it
# prompts for a password rather than after.
require_query_environment() {
  case ",$QUERY_ENVIRONMENTS," in
    *",$ENV_NAME,"*) return 0 ;;
  esac
  die "Refusing: the read-only query stage is not enabled for environment '$ENV_NAME'." \
    "This stage returns loan data into a terminal, a transcript, and possibly a file" \
    "someone commits. The views mask identifiers, but the environments it may run" \
    "against are listed explicitly here rather than taken from the command line." \
    "Permitted: $QUERY_ENVIRONMENTS." \
    "To add one, edit QUERY_ENVIRONMENTS in scripts/deploy -- deliberately, in a commit" \
    "someone reviews."
}

require_provisioning_environment() {
  case ",$PROVISIONING_ENVIRONMENTS," in
    *",$ENV_NAME,"*) return 0 ;;
  esac
  die "Refusing: account provisioning is not enabled for environment '$ENV_NAME'." \
    "These stages create an account that can log in and read borrower files, so the" \
    "environments they may run against are listed explicitly in this script rather" \
    "than taken from the command line. Permitted: $PROVISIONING_ENVIRONMENTS." \
    "To add one, edit PROVISIONING_ENVIRONMENTS in scripts/deploy -- deliberately, in" \
    "a commit someone reviews."
}

# Hash the password on THIS machine. scripts/hash-password prompts on stderr and
# writes only the 60-character hash to stdout, so this captures the hash alone.
hash_password_locally() {
  local helper="$REPO_ROOT/scripts/hash-password" hash
  [ -x "$helper" ] || die "scripts/hash-password is missing or not executable."
  hash=$("$helper") || die "Password hashing failed. Nothing was run."
  if [ "${#hash}" -ne 60 ]; then
    die "The local hash is ${#hash} characters, expected 60." \
      "Refusing to send a value that is not a complete bcrypt hash."
  fi
  printf '%s' "$hash"
}

# Resolve the container name from the task definition rather than assuming it.
#
# `|| printf ''` is load-bearing: 2>/dev/null hides the AWS error but not the
# exit status, and under `set -e` a failing command substitution kills the script
# on the spot -- taking with it the caller's own `die`, which is the only place
# that explains what went wrong. Returning empty lets that guard run.
oneoff_container_name() {
  awsx ecs describe-task-definition --task-definition "$1" \
    --query 'taskDefinition.containerDefinitions[0].name' --output text 2>/dev/null \
    || printf ''
}

# Network configuration read off the running API service -- tasks are pinned to
# the AZs that have interface endpoints, and the raw private_subnet_ids output
# includes AZs that do not. Identical reasoning to the migrate stage.
oneoff_network() {
  local cluster="$1" api_svc netcfg
  api_svc=$(out_map ecs_service_names api)
  netcfg=$(awsx ecs describe-services --cluster "$cluster" --services "$api_svc" \
    --query 'services[0].networkConfiguration.awsvpcConfiguration.[join(`,`,subnets),join(`,`,securityGroups)]' \
    --output text 2>/dev/null || printf '')
  if [ -n "$netcfg" ] && [ "$netcfg" != "None	None" ]; then
    printf '%s' "$netcfg"
    return 0
  fi
  printf '%s\t%s' "$(out_list_first private_subnet_ids)" "$(out ecs_tasks_security_group_id)"
}

# Run a prepared request, wait for it to stop, print its logs, return its exit
# code. The request file is written by the caller and removed here.
ONEOFF_EXIT_CODE=""
run_oneoff_task() {
  local label="$1" request="$2" cluster="$3" container="$4"
  local arn task_id status elapsed=0 group stream reason
  ONEOFF_EXIT_CODE=""

  would "aws ecs run-task --cli-input-json file://<request>   ($label)"
  arn=$(awsx ecs run-task --cli-input-json "file://$request" \
    --query 'tasks[0].taskArn' --output text) || { rm -f "$request"; die "run-task failed for $label."; }
  rm -f "$request"

  if [ -z "$arn" ] || [ "$arn" = "None" ]; then
    die "run-task returned no task ARN for $label." \
      "Check the failures[] entry in the API response."
  fi
  task_id="${arn##*/}"
  ok "task started: $task_id"

  while [ "$elapsed" -lt "$MIGRATE_TIMEOUT_SECONDS" ]; do
    status=$(awsx ecs describe-tasks --cluster "$cluster" --tasks "$arn" \
      --query 'tasks[0].lastStatus' --output text 2>/dev/null || printf 'UNKNOWN')
    [ "$status" = "STOPPED" ] && break
    note "  ${elapsed}s: $status"
    sleep 10
    elapsed=$((elapsed + 10))
  done

  if [ "$status" != "STOPPED" ]; then
    die "$label did not stop within ${MIGRATE_TIMEOUT_SECONDS}s (last status: $status)." \
      "Task: $arn"
  fi

  group=$(log_group_for api)
  stream="migrate/${container}/${task_id}"
  hr
  info "CloudWatch logs -- $group : $stream"
  hr
  awsx logs get-log-events --log-group-name "$group" --log-stream-name "$stream" \
    --start-from-head --query 'events[].message' --output text 2>/dev/null \
    | tr '\t' '\n' | sed 's/^/  /' \
    || warn "No log stream for this task. The container died before it logged anything."
  hr

  ONEOFF_EXIT_CODE=$(awsx ecs describe-tasks --cluster "$cluster" --tasks "$arn" \
    --query 'tasks[0].containers[0].exitCode' --output text 2>/dev/null || printf 'None')
  reason=$(awsx ecs describe-tasks --cluster "$cluster" --tasks "$arn" \
    --query 'tasks[0].stoppedReason' --output text 2>/dev/null || printf '')
  [ "$ONEOFF_EXIT_CODE" = "0" ] && return 0
  die "$label exited with code '${ONEOFF_EXIT_CODE}'." \
    "stoppedReason: ${reason:-(none)}" \
    "The logs above are the reason. A REFUSED line means a guard in the script" \
    "declined and nothing was written."
}

stage_bootstrap_admin() {
  banner "bootstrap-admin -- the FIRST company and admin user in '$ENV_NAME'"
  need_cmd aws; need_cmd jq; need_cmd terraform
  require_identity "$ACCOUNT_ID"
  require_provisioning_environment
  # Outputs first: require_cognito_enabled reads one.
  require_outputs "$ENV_DIR"
  require_cognito_enabled

  local cluster taskdef container subnets sgs netcfg request
  cluster=$(out ecs_cluster_name)
  taskdef=$(out_map ecs_task_definition_arns migrate)
  container=$(oneoff_container_name "$taskdef")
  [ -n "$container" ] && [ "$container" != "None" ] || die \
    "Could not resolve the container name from the migrate task definition."

  info ""
  info "This runs app.scripts.bootstrap_admin as a one-off task on the EXISTING"
  info "migrate task definition -- it already has DATABASE_URL injected and lands"
  info "in the subnets that have the interface endpoints."
  info ""
  hazard "The script REFUSES if the database already contains any user."
  info "  It is a bootstrap, not a user-creation tool. Use the add-user stage for"
  info "  an environment that already has accounts."
  info ""

  local email first last coname coslug hash
  email=$(ask_required "Admin email")
  first=$(ask_required "Admin first name")
  last=$(ask_required "Admin last name")
  coname=$(ask_required "Company name")
  coslug=$(ask_required "Company slug (lowercase, url-safe)")

  info ""
  info "  The password is hashed HERE and never sent. Only the bcrypt hash travels."
  hash=$(hash_password_locally)
  ok "hashed locally (60 chars, never displayed)"

  ensure_secret_tmpdir
  netcfg=$(oneoff_network "$cluster")
  subnets=$(printf '%s' "$netcfg" | awk -F'\t' '{print $1}')
  sgs=$(printf '%s' "$netcfg" | awk -F'\t' '{print $2}')

  hr
  info "  environment : $ENV_NAME"
  info "  cluster     : $cluster"
  info "  container   : $container"
  info "  admin       : $email"
  info "  company     : $coname ($coslug)"
  info "  password    : hashed locally, not shown, not sent"
  hr
  confirm "Create this company and admin user?" || die "Aborted. Nothing was run."

  request="$SECRET_TMPDIR/bootstrap-admin.$$.json"
  # ⚠️ jq reads from the ENVIRONMENT, never --arg: an --arg value would be in
  # jq's own command line, which `ps` shows to every user on this machine.
  (
    umask 077
    ONEOFF_CLUSTER="$cluster" ONEOFF_TD="$taskdef" ONEOFF_CONTAINER="$container" \
    ONEOFF_SUBNETS="$subnets" ONEOFF_SGS="$sgs" \
    BOOTSTRAP_ADMIN_EMAIL="$email" BOOTSTRAP_ADMIN_PASSWORD_HASH="$hash" \
    BOOTSTRAP_ADMIN_FIRST_NAME="$first" BOOTSTRAP_ADMIN_LAST_NAME="$last" \
    BOOTSTRAP_COMPANY_NAME="$coname" BOOTSTRAP_COMPANY_SLUG="$coslug" \
    BOOTSTRAP_ALLOWED_ENVIRONMENTS="$PROVISIONING_ENVIRONMENTS" \
      jq -n '{
        cluster: env.ONEOFF_CLUSTER,
        taskDefinition: env.ONEOFF_TD,
        launchType: "FARGATE",
        networkConfiguration: {awsvpcConfiguration: {
          subnets: (env.ONEOFF_SUBNETS | split(",")),
          securityGroups: (env.ONEOFF_SGS | split(",")),
          assignPublicIp: "DISABLED"}},
        overrides: {containerOverrides: [{
          name: env.ONEOFF_CONTAINER,
          command: ["uv","run","python","-m","app.scripts.bootstrap_admin"],
          environment: [
            {name:"BOOTSTRAP_ADMIN_EMAIL",          value: env.BOOTSTRAP_ADMIN_EMAIL},
            {name:"BOOTSTRAP_ADMIN_PASSWORD_HASH",  value: env.BOOTSTRAP_ADMIN_PASSWORD_HASH},
            {name:"BOOTSTRAP_ADMIN_FIRST_NAME",     value: env.BOOTSTRAP_ADMIN_FIRST_NAME},
            {name:"BOOTSTRAP_ADMIN_LAST_NAME",      value: env.BOOTSTRAP_ADMIN_LAST_NAME},
            {name:"BOOTSTRAP_COMPANY_NAME",         value: env.BOOTSTRAP_COMPANY_NAME},
            {name:"BOOTSTRAP_COMPANY_SLUG",         value: env.BOOTSTRAP_COMPANY_SLUG},
            {name:"BOOTSTRAP_ALLOWED_ENVIRONMENTS", value: env.BOOTSTRAP_ALLOWED_ENVIRONMENTS}
          ]}]}
      }' >"$request"
  ) || die "Could not build the run-task request."
  hash=""

  run_oneoff_task "bootstrap-admin" "$request" "$cluster" "$container"
  ok "bootstrap-admin complete."
  info ""
  info "Next: create the matching COGNITO user -- this account gets you past the"
  info "application's own login, not past the load balancer:"
  info "  aws cognito-idp admin-create-user --user-pool-id \$(terraform -chdir=$ENV_DIR output -raw cognito_user_pool_id) \\"
  info "    --username $email --user-attributes Name=email,Value=$email Name=email_verified,Value=true"
}

stage_add_user() {
  banner "add-user -- add a user to an existing company in '$ENV_NAME'"
  need_cmd aws; need_cmd jq; need_cmd terraform
  require_identity "$ACCOUNT_ID"
  require_provisioning_environment
  # Outputs first: require_cognito_enabled reads one.
  require_outputs "$ENV_DIR"
  require_cognito_enabled

  local cluster taskdef container subnets sgs netcfg request
  cluster=$(out ecs_cluster_name)
  taskdef=$(out_map ecs_task_definition_arns migrate)
  container=$(oneoff_container_name "$taskdef")
  [ -n "$container" ] && [ "$container" != "None" ] || die \
    "Could not resolve the container name from the migrate task definition."

  info ""
  info "Adds ONE user to a company that already exists. The script refuses an"
  info "unknown company slug rather than creating one, and refuses an email that"
  info "is already taken -- email is globally unique, not per company."
  info ""

  local email first last role coslug hash
  email=$(ask_required "Email")
  first=$(ask_required "First name")
  last=$(ask_required "Last name")
  role=$(ask_required "Role (ADMIN or PROCESSOR)")
  case "$(printf '%s' "$role" | tr '[:upper:]' '[:lower:]')" in
    admin | processor) ;;
    *) die "Role must be ADMIN or PROCESSOR, got '$role'." "Nothing was run." ;;
  esac
  coslug=$(ask_required "Company slug (must already exist)")

  info ""
  info "  The password is hashed HERE and never sent. Only the bcrypt hash travels."
  hash=$(hash_password_locally)
  ok "hashed locally (60 chars, never displayed)"

  ensure_secret_tmpdir
  netcfg=$(oneoff_network "$cluster")
  subnets=$(printf '%s' "$netcfg" | awk -F'\t' '{print $1}')
  sgs=$(printf '%s' "$netcfg" | awk -F'\t' '{print $2}')

  hr
  info "  environment : $ENV_NAME"
  info "  user        : $email"
  info "  role        : $role"
  info "  company     : $coslug"
  info "  password    : hashed locally, not shown, not sent"
  hr
  confirm "Create this user?" || die "Aborted. Nothing was run."

  request="$SECRET_TMPDIR/add-user.$$.json"
  (
    umask 077
    ONEOFF_CLUSTER="$cluster" ONEOFF_TD="$taskdef" ONEOFF_CONTAINER="$container" \
    ONEOFF_SUBNETS="$subnets" ONEOFF_SGS="$sgs" \
    ADD_USER_EMAIL="$email" ADD_USER_PASSWORD_HASH="$hash" \
    ADD_USER_FIRST_NAME="$first" ADD_USER_LAST_NAME="$last" \
    ADD_USER_ROLE="$role" ADD_USER_COMPANY_SLUG="$coslug" \
    ADD_USER_ALLOWED_ENVIRONMENTS="$PROVISIONING_ENVIRONMENTS" \
      jq -n '{
        cluster: env.ONEOFF_CLUSTER,
        taskDefinition: env.ONEOFF_TD,
        launchType: "FARGATE",
        networkConfiguration: {awsvpcConfiguration: {
          subnets: (env.ONEOFF_SUBNETS | split(",")),
          securityGroups: (env.ONEOFF_SGS | split(",")),
          assignPublicIp: "DISABLED"}},
        overrides: {containerOverrides: [{
          name: env.ONEOFF_CONTAINER,
          command: ["uv","run","python","-m","app.scripts.add_user"],
          environment: [
            {name:"ADD_USER_EMAIL",                value: env.ADD_USER_EMAIL},
            {name:"ADD_USER_PASSWORD_HASH",        value: env.ADD_USER_PASSWORD_HASH},
            {name:"ADD_USER_FIRST_NAME",           value: env.ADD_USER_FIRST_NAME},
            {name:"ADD_USER_LAST_NAME",            value: env.ADD_USER_LAST_NAME},
            {name:"ADD_USER_ROLE",                 value: env.ADD_USER_ROLE},
            {name:"ADD_USER_COMPANY_SLUG",         value: env.ADD_USER_COMPANY_SLUG},
            {name:"ADD_USER_ALLOWED_ENVIRONMENTS", value: env.ADD_USER_ALLOWED_ENVIRONMENTS}
          ]}]}
      }' >"$request"
  ) || die "Could not build the run-task request."
  hash=""

  run_oneoff_task "add-user" "$request" "$cluster" "$container"
  ok "add-user complete."
}

# ---------------------------------------------------------------------------
# query-setup -- provision the read-only role (C7)
#
# Separate from `migrate` on purpose. Migrations run everywhere; this role must not
# exist in production, so it is created by a stage that refuses any environment outside
# QUERY_ENVIRONMENTS. Run once per environment, after migrate.
stage_query_setup() {
  banner "query-setup -- provision the read-only query role in '$ENV_NAME'"
  need_cmd aws; need_cmd jq; need_cmd terraform
  require_identity "$ACCOUNT_ID"
  require_query_environment
  require_outputs "$ENV_DIR"

  local cluster taskdef container subnets sgs netcfg request drop_flag
  cluster=$(out ecs_cluster_name)
  taskdef=$(out_map ecs_task_definition_arns migrate)
  container=$(oneoff_container_name "$taskdef")
  [ -n "$container" ] && [ "$container" != "None" ] || die \
    "Could not resolve the container name from the migrate task definition."

  drop_flag="${QUERY_SETUP_DROP:-}"

  ensure_secret_tmpdir
  netcfg=$(oneoff_network "$cluster")
  subnets=$(printf '%s' "$netcfg" | awk -F'\t' '{print $1}')
  sgs=$(printf '%s' "$netcfg" | awk -F'\t' '{print $2}')

  hr
  info "  environment : $ENV_NAME"
  info "  action      : ${drop_flag:+DROP the role}${drop_flag:-create/repair the role and its grants}"
  info "  role        : mbai_readonly (no password; RDS IAM token only)"
  hr
  confirm "Proceed?" || die "Aborted. Nothing was run."

  request="$SECRET_TMPDIR/query-setup.$$.json"
  (
    umask 077
    ONEOFF_CLUSTER="$cluster" ONEOFF_TD="$taskdef" ONEOFF_CONTAINER="$container" \
    ONEOFF_SUBNETS="$subnets" ONEOFF_SGS="$sgs" \
    PQR_ENV="$ENV_NAME" PQR_ALLOWED="$QUERY_ENVIRONMENTS" PQR_DROP="$drop_flag" \
      jq -n '{
        cluster: env.ONEOFF_CLUSTER,
        taskDefinition: env.ONEOFF_TD,
        launchType: "FARGATE",
        networkConfiguration: {awsvpcConfiguration: {
          subnets: (env.ONEOFF_SUBNETS | split(",")),
          securityGroups: (env.ONEOFF_SGS | split(",")),
          assignPublicIp: "DISABLED"}},
        overrides: {containerOverrides: [{
          name: env.ONEOFF_CONTAINER,
          command: ["uv","run","python","-m","app.scripts.provision_query_role"],
          environment: [
            {name:"PROVISION_QUERY_ROLE_ENVIRONMENT",  value: env.PQR_ENV},
            {name:"PROVISION_QUERY_ROLE_ENVIRONMENTS", value: env.PQR_ALLOWED},
            {name:"PROVISION_QUERY_ROLE_DROP",         value: env.PQR_DROP}
          ]}]}
      }' >"$request"
  ) || die "Could not build the run-task request."

  run_oneoff_task "query-setup" "$request" "$cluster" "$container"
  ok "query-setup complete."
}

# ---------------------------------------------------------------------------
# query -- read-only SELECT against the deployed database (C7)
#
# Same one-off-task mechanism as migrate / bootstrap-admin / add-user: the migrate
# task definition already has DATABASE_URL injected and lands in the subnet that has
# the interface endpoints. Nothing new is provisioned and there is no standing cost.
#
# The SQL travels in the container ENVIRONMENT, never in the command. A task's argv is
# readable from `ecs describe-tasks` for about an hour after it stops and the whole
# RunTask call is recorded in CloudTrail -- the same reason add-user sends a hash.
#
# No confirm() call, deliberately. The path is read-only by database grant and is meant
# to be called repeatedly, including by the agent; a prompt would make it unusable for
# the consumer it was built for.
stage_query() {
  banner "query -- read-only SELECT against '$ENV_NAME'"
  need_cmd aws; need_cmd jq; need_cmd terraform
  require_identity "$ACCOUNT_ID"
  require_query_environment
  require_outputs "$ENV_DIR"

  local sql
  if [ -n "$QUERY_SQL_INLINE" ] && [ -n "$QUERY_FILE" ]; then
    die "Pass EITHER a .sql file or -c, not both."
  elif [ -n "$QUERY_SQL_INLINE" ]; then
    sql="$QUERY_SQL_INLINE"
  elif [ -n "$QUERY_FILE" ]; then
    [ -f "$QUERY_FILE" ] || die "No such file: $QUERY_FILE"
    sql=$(cat "$QUERY_FILE") || die "Could not read $QUERY_FILE"
  else
    die "Nothing to run." \
      "Usage: ./scripts/deploy $ENV_NAME query <file.sql>" \
      "   or: ./scripts/deploy $ENV_NAME query -c \"select ...\""
  fi
  [ -n "${sql//[[:space:]]/}" ] || die "The SQL is empty."

  local cluster taskdef container subnets sgs netcfg request
  cluster=$(out ecs_cluster_name)
  taskdef=$(out_map ecs_task_definition_arns migrate)
  container=$(oneoff_container_name "$taskdef")
  [ -n "$container" ] && [ "$container" != "None" ] || die \
    "Could not resolve the container name from the migrate task definition."

  ensure_secret_tmpdir
  netcfg=$(oneoff_network "$cluster")
  subnets=$(printf '%s' "$netcfg" | awk -F'\t' '{print $1}')
  sgs=$(printf '%s' "$netcfg" | awk -F'\t' '{print $2}')

  hr
  info "  environment : $ENV_NAME"
  info "  connects as : mbai_readonly (readonly.* views only; no access to public)"
  info "  max rows    : ${QUERY_MAX_ROWS:-100}"
  hr
  printf '%s\n' "$sql" | sed 's/^/  /'
  hr

  request="$SECRET_TMPDIR/query.$$.json"
  (
    umask 077
    ONEOFF_CLUSTER="$cluster" ONEOFF_TD="$taskdef" ONEOFF_CONTAINER="$container" \
    ONEOFF_SUBNETS="$subnets" ONEOFF_SGS="$sgs" \
    QUERY_SQL="$sql" QUERY_MAX_ROWS="${QUERY_MAX_ROWS:-100}" \
      jq -n '{
        cluster: env.ONEOFF_CLUSTER,
        taskDefinition: env.ONEOFF_TD,
        launchType: "FARGATE",
        networkConfiguration: {awsvpcConfiguration: {
          subnets: (env.ONEOFF_SUBNETS | split(",")),
          securityGroups: (env.ONEOFF_SGS | split(",")),
          assignPublicIp: "DISABLED"}},
        overrides: {containerOverrides: [{
          name: env.ONEOFF_CONTAINER,
          command: ["uv","run","python","-m","app.scripts.run_query"],
          environment: [
            {name:"QUERY_SQL",      value: env.QUERY_SQL},
            {name:"QUERY_MAX_ROWS", value: env.QUERY_MAX_ROWS}
          ]}]}
      }' >"$request"
  ) || die "Could not build the run-task request."

  run_oneoff_task "query" "$request" "$cluster" "$container"
  ok "query complete."
  info ""
  info "Remember the matching Cognito user, or they cannot reach the application."
}

# --------------------------------------------------------------------------- #
# Stage: phase2
# --------------------------------------------------------------------------- #

stage_phase2() {
  banner "phase2 -- TLS + Cognito for $ENV_NAME"
  need_cmd terraform; need_cmd aws; need_cmd jq; need_cmd dig
  require_domain
  require_identity "$ACCOUNT_ID"

  # The refusal that matters most in this stage.
  local count
  count=$(ns_awsdns_count "$DOMAIN")
  if [ "$count" -lt 4 ]; then
    die "Refusing to run phase2: $DOMAIN has $count/4 AWS nameservers." \
      "ACM validates over DNS. Without delegation the certificate sits in" \
      "PENDING_VALIDATION until the apply times out 45 minutes later, and the" \
      "environment is left half-applied in the meantime." \
      "Run:  ./scripts/deploy $ENV_NAME dns"
  fi
  ok "delegation live: $count AWS nameservers answer for $DOMAIN"

  local tls cognito
  tls=$(tfvar "$TFVARS" "enable_tls" || printf '')
  cognito=$(tfvar "$TFVARS" "enable_cognito" || printf '')

  if [ "$tls" != "true" ] || [ "$cognito" != "true" ]; then
    info ""
    info "phase2 flips BOTH flags in $TFVARS:"
    info "    enable_tls     $tls  ->  true"
    info "    enable_cognito $cognito  ->  true"
    hazard "They move together, always."
    info "  An ALB cannot attach authenticate-cognito to an HTTP listener, so"
    info "  modules/compute/alb.tf fails the plan on (cognito = true, tls = false)"
    info "  rather than letting the environment come up with no authentication while"
    info "  appearing configured. Flipping only one is a plan failure either way."
    confirm "Edit $TFVARS to set both to true?" || die "Aborted by operator. Nothing was changed."

    would "sed -i: enable_tls = true, enable_cognito = true in $TFVARS"
    # Rewrite only the assignment, leaving the trailing comment on the line intact.
    sed -i.bak \
      -e 's/^\([[:space:]]*enable_tls[[:space:]]*=[[:space:]]*\)false/\1true/' \
      -e 's/^\([[:space:]]*enable_cognito[[:space:]]*=[[:space:]]*\)false/\1true/' \
      "$TFVARS"
    rm -f "${TFVARS}.bak"

    tls=$(tfvar "$TFVARS" "enable_tls" || printf '')
    cognito=$(tfvar "$TFVARS" "enable_cognito" || printf '')
    { [ "$tls" = "true" ] && [ "$cognito" = "true" ]; } || die \
      "Failed to flip the flags in $TFVARS (now tls=$tls cognito=$cognito)." \
      "Edit the file by hand and re-run."
    ok "flags flipped -- this is a tracked file, so it will show in git status."
  else
    note "enable_tls and enable_cognito are already true."
  fi

  local plan rc
  plan="$ENV_DIR/${ENV_NAME}-tls.tfplan"
  init_or_explain_lockfile "$ENV_DIR" "$ENV_NAME"

  set +e; tf_plan "$ENV_DIR" "$plan"; rc=$?; set -e
  if [ "$rc" -eq 0 ]; then
    ok "phase2: no changes. TLS and Cognito are already applied."
    rm -f "$plan"
    return 0
  fi

  hr
  info "This creates the ACM certificate and its validation records, waits for"
  info "issuance, adds the HTTPS listener with authenticate-cognito on EVERY rule,"
  info "and converts port 80 into a 301 redirect."
  hazard "Certificate issuance can take several minutes. Do not interrupt the apply."
  hr

  if ! confirm "Apply this phase-2 plan?"; then
    rm -f "$plan"
    die "Aborted by operator. Nothing was applied." \
      "Note the tfvars flags are already flipped -- either apply, or set them back."
  fi

  would "terraform -chdir=$ENV_DIR apply $(basename "$plan")"
  tf "$ENV_DIR" apply -input=false "$(basename "$plan")" || die "phase2 apply failed." \
    "If ACM is stuck in PENDING_VALIDATION the cause is delegation: re-check" \
    "  dig +short NS $DOMAIN"
  rm -f "$plan"
  ok "phase2 applied."
}

# --------------------------------------------------------------------------- #
# Stage: deploy -- ship application code
#
# The infrastructure stages build an environment. This one ships a change to the
# application into an environment that already exists. It is `images` + an apply
# with three things those two do not do:
#
#   1. The tag is DERIVED FROM GIT, not typed. Both CannotPullContainerError
#      failures this project has had came from the tag and the bytes disagreeing
#      -- a tag bumped without a build, and a build without a bump. A tag that is
#      a function of the commit cannot disagree with what was built from it.
#   2. It checks WHICH BRANCH it is shipping. `docker build` ships the working
#      tree of the directory it runs in; this machine has several worktrees on
#      different branches, and a SHA names a commit but not a line of work.
#   3. It runs MIGRATIONS BETWEEN the push and the service update, and only when
#      the deploy actually introduces any. A service rolling onto code that
#      expects a column which does not exist yet surfaces as an application bug,
#      not as a deploy failure.
# --------------------------------------------------------------------------- #

# Values set for the rollback hint in cleanup(). See deploy_rollback_hint.
DEPLOY_PREV_TAG=""
DEPLOY_NEW_TAG=""
DEPLOY_SUCCEEDED=0

# Extract a list-valued tfvar as one entry per line. The generic tfvar() reader
# returns the raw HCL (`["a", "b"]`); this pulls the quoted strings out of it.
tfvar_list() {
  local raw
  raw=$(tfvar "$1" "$2") || return 1
  printf '%s' "$raw" | tr ',' '\n' | sed -n 's/.*"\([^"]*\)".*/\1/p'
}

# --- git preflight --------------------------------------------------------- #

# ⚠️ UNTRACKED FILES COUNT AS DIRTY, and that is not pedantry: `docker build`
# sends the WORKING TREE as its context, not the commit. An untracked file that
# .dockerignore does not exclude is in the image. A tag naming a commit that does
# not describe the built bytes is the exact failure this stage exists to remove.
deploy_require_clean_tree() {
  local dirty
  dirty=$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null) || die \
    "$REPO_ROOT is not a git repository." "The deploy stage derives its tag from git."
  [ -z "$dirty" ] && return 0

  info ""
  printf '%s\n' "$dirty" | head -20 | sed 's/^/    /'
  local n
  n=$(printf '%s\n' "$dirty" | grep -c . | tr -d '[:space:]')
  info ""
  die "Refusing to deploy: the working tree has $n uncommitted change(s)." \
    "The image tag would name HEAD, but the build context is the working tree, so" \
    "the tag would describe bytes that no commit contains -- including untracked" \
    "files, which docker sends whether or not git tracks them." \
    "" \
    "Commit them, stash them, or remove them, then re-run."
}

deploy_require_allowed_branch() {
  local branch="$1" allowed found=0 entry
  allowed=$(tfvar_list "$TFVARS" allowed_deploy_branches 2>/dev/null || printf '')

  if [ -z "$allowed" ]; then
    die "allowed_deploy_branches is unset or empty in $TFVARS." \
      "It fails closed: with no branch permitted, nothing deploys. Set it to the" \
      "branch this environment ships from, e.g." \
      "  allowed_deploy_branches = [\"bedrock_integration\"]"
  fi

  while IFS= read -r entry; do
    [ "$entry" = "$branch" ] && found=1
  done <<EOF
$allowed
EOF

  [ "$found" = "1" ] && return 0

  if [ "${ALLOW_BRANCH:-0}" = "1" ]; then
    hazard "--allow-branch: shipping from '$branch', which $TFVARS does not permit."
    info "  Permitted: $(printf '%s' "$allowed" | tr '\n' ' ')"
    info "  The branch is recorded in the image labels either way, so this deploy"
    info "  stays identifiable afterwards."
    return 0
  fi

  die "Refusing to deploy from branch '$branch'." \
    "$TFVARS permits: $(printf '%s' "$allowed" | tr '\n' ' ')" \
    "" \
    "This machine has several worktrees on different branches, and docker build" \
    "ships whatever is checked out where it runs. The image tag would carry the" \
    "right commit SHA and the wrong line of work, and nothing downstream would" \
    "notice." \
    "" \
    "Check you are in the right directory:  $REPO_ROOT" \
    "Deliberate? Re-run with --allow-branch."
}

# Reports against the LAST FETCH -- this does not fetch, because a deploy command
# should not quietly mutate refs. Being ahead is the case that matters most and
# needs no fetch to detect: it means the code about to ship exists nowhere else.
deploy_report_remote_divergence() {
  local branch="$1" upstream counts ahead behind
  upstream=$(git -C "$REPO_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || printf '')

  if [ -z "$upstream" ]; then
    warn "Branch '$branch' has NO UPSTREAM."
    warn "  Nothing to compare against: this code exists only on this machine, so"
    warn "  the deployed image will be the only copy of it outside this worktree."
    return 0
  fi

  counts=$(git -C "$REPO_ROOT" rev-list --left-right --count "${upstream}...HEAD" 2>/dev/null || printf '')
  behind=$(printf '%s' "$counts" | awk '{print $1}')
  ahead=$(printf '%s' "$counts" | awk '{print $2}')

  if [ "${ahead:-0}" != "0" ]; then
    warn "$ahead commit(s) ahead of $upstream -- shipping work that is not pushed."
  fi
  if [ "${behind:-0}" != "0" ]; then
    warn "$behind commit(s) behind $upstream (as of the last fetch)."
  fi
  if [ "${ahead:-0}" = "0" ] && [ "${behind:-0}" = "0" ]; then
    note "in sync with $upstream (as of the last fetch)"
  else
    note "  Run \`git fetch\` for a current comparison -- this reads local refs only."
  fi
}

# --- alembic head comparison ----------------------------------------------- #

# The revisions this checkout would apply. `alembic heads` reads the versions
# directory and does NOT execute env.py, so it needs no database and no app
# settings (verified).
local_alembic_heads() {
  local py out
  py="$REPO_ROOT/backend/.venv/bin/python"
  [ -x "$py" ] || die "backend/.venv is missing -- needed to read the local Alembic head." \
    "Run: cd backend && uv sync"
  out=$(cd "$REPO_ROOT/backend" && "$py" -m alembic heads 2>/dev/null) || die \
    "Could not read the local Alembic heads."
  printf '%s\n' "$out" | awk 'NF {print $1}' | sort
}

# The revisions the DEPLOYED database is at. Runs a one-off task on the CURRENT
# migrate task definition -- reading alembic_version needs no new image.
# Progress goes to stderr; only the revisions reach stdout.
deployed_alembic_heads() {
  local cluster="$1" taskdef="$2" container="$3" request logs
  ensure_secret_tmpdir
  request="$SECRET_TMPDIR/alembic-head.$$.json"

  ONEOFF_CLUSTER="$cluster" ONEOFF_TD="$taskdef" ONEOFF_CONTAINER="$container" \
  ONEOFF_SUBNETS="$DEPLOY_SUBNETS" ONEOFF_SGS="$DEPLOY_SGS" \
  ONEOFF_PROG='
import asyncio
from sqlalchemy import text
from app.core.database import async_session_maker

async def main():
    async with async_session_maker() as db:
        try:
            rows = (await db.execute(text("select version_num from alembic_version"))).scalars().all()
        except Exception:
            rows = []
        for r in sorted(rows):
            print("ALEMBIC_HEAD=%s" % r, flush=True)
        print("ALEMBIC_HEAD_COUNT=%d" % len(rows), flush=True)

asyncio.run(main())
' jq -n '{
    cluster: env.ONEOFF_CLUSTER, taskDefinition: env.ONEOFF_TD, launchType: "FARGATE",
    networkConfiguration: {awsvpcConfiguration: {
      subnets: (env.ONEOFF_SUBNETS | split(",")),
      securityGroups: (env.ONEOFF_SGS | split(",")), assignPublicIp: "DISABLED"}},
    overrides: {containerOverrides: [{
      name: env.ONEOFF_CONTAINER,
      command: ["uv","run","python","-c",env.ONEOFF_PROG]}]}
  }' >"$request" || die "Could not build the alembic-head request."

  logs=$(oneoff_task_logs "read deployed Alembic head" "$request" "$cluster" "$container") || return 1
  printf '%s\n' "$logs" | sed -n 's/^[[:space:]]*ALEMBIC_HEAD=\(.*\)$/\1/p' | sort
}

# Run a task, wait, and return its LOG TEXT on stdout. Progress on stderr, so the
# caller can capture the output -- the distinction that made the secrets stage
# unusable when it was got wrong.
oneoff_task_logs() {
  local label="$1" request="$2" cluster="$3" container="$4"
  local arn task_id status elapsed=0 group stream exit_code
  {
    would "aws ecs run-task --cli-input-json file://<request>   ($label)"
    arn=$(awsx ecs run-task --cli-input-json "file://$request" \
      --query 'tasks[0].taskArn' --output text) || { rm -f "$request"; die "run-task failed for $label."; }
    rm -f "$request"
    [ -n "$arn" ] && [ "$arn" != "None" ] || die "run-task returned no task ARN for $label."
    task_id="${arn##*/}"
    ok "task started: $task_id"
    while [ "$elapsed" -lt "$MIGRATE_TIMEOUT_SECONDS" ]; do
      status=$(awsx ecs describe-tasks --cluster "$cluster" --tasks "$arn" \
        --query 'tasks[0].lastStatus' --output text 2>/dev/null || printf 'UNKNOWN')
      [ "$status" = "STOPPED" ] && break
      note "  ${elapsed}s: $status"
      sleep 10
      elapsed=$((elapsed + 10))
    done
    [ "$status" = "STOPPED" ] || die "$label did not stop within ${MIGRATE_TIMEOUT_SECONDS}s."
    exit_code=$(awsx ecs describe-tasks --cluster "$cluster" --tasks "$arn" \
      --query 'tasks[0].containers[0].exitCode' --output text 2>/dev/null || printf 'None')
  } >&2

  group=$(log_group_for api)
  stream="migrate/${container}/${task_id}"
  awsx logs get-log-events --log-group-name "$group" --log-stream-name "$stream" \
    --start-from-head --query 'events[].message' --output text 2>/dev/null | tr '\t' '\n'

  if [ "$exit_code" != "0" ]; then
    printf '%s\n' "--- the task above exited $exit_code; its log is printed here ---" >&2
    die "$label exited with code '$exit_code'."
  fi
}

# --- running the migration on the NEW image -------------------------------- #

# ⚠️ Why this registers a task definition instead of reusing the deployed one.
#
# The migration must run the NEW code: it is the new image that carries the new
# revisions. But the deployed migrate task definition still points at the OLD
# tag until Terraform applies, and that same apply also updates the SERVICES --
# so waiting for it would put the services on new code before the migration ran,
# which is precisely the ordering this stage exists to get right. ECS
# containerOverrides can override the command and the environment but NOT the
# image, so there is no way to redirect the existing definition at the new tag.
#
# The standard resolution, and the one used here: register one extra revision of
# the same family with the image swapped, run that, and let Terraform carry on
# managing its own revisions afterwards. Terraform tracks the revision IT
# created, so an extra one is inert -- it costs a revision number, not
# correctness. The alternative, `terraform apply -target` on the task definition,
# keeps everything in Terraform but couples this script to a module-internal
# resource address and doubles the applies.
register_migrate_taskdef_for_image() {
  local taskdef="$1" image="$2" src reg arn
  ensure_secret_tmpdir
  src="$SECRET_TMPDIR/td-src.$$.json"
  reg="$SECRET_TMPDIR/td-reg.$$.json"

  awsx ecs describe-task-definition --task-definition "$taskdef" \
    --query 'taskDefinition' --output json >"$src" 2>/dev/null || die \
    "Could not read the migrate task definition '$taskdef'."

  # Strip the server-owned fields describe returns but register rejects, and
  # swap the image on every container (there is one).
  NEW_IMAGE="$image" jq '
      del(.taskDefinitionArn, .revision, .status, .requiresAttributes,
          .compatibilities, .registeredAt, .registeredBy, .deregisteredAt)
      | .containerDefinitions |= map(.image = env.NEW_IMAGE)
    ' "$src" >"$reg" || die "Could not build the task-definition registration."
  rm -f "$src"

  arn=$(awsx ecs register-task-definition --cli-input-json "file://$reg" \
    --query 'taskDefinition.taskDefinitionArn' --output text) || {
      rm -f "$reg"; die "register-task-definition failed."; }
  rm -f "$reg"
  printf '%s' "$arn"
}

# --- services -------------------------------------------------------------- #

# ⚠️ Does not return while a deployment is still rolling. The circuit breaker can
# still roll it back, so an exit here would report success for something that has
# not finished failing yet.
wait_for_services_steady() {
  local cluster="$1" elapsed=0 svc name pending all_steady
  local names=""
  for svc in api worker frontend; do
    name=$(out_map_opt ecs_service_names "$svc")
    [ -n "$name" ] && names="$names $name"
  done
  [ -n "$names" ] || { warn "No service names in the outputs; skipping the steady-state wait."; return 0; }

  info ""
  info "Waiting for all services to reach steady state (rollout + circuit breaker)."
  while [ "$elapsed" -lt "$DEPLOY_STEADY_TIMEOUT_SECONDS" ]; do
    all_steady=1
    pending=""
    for name in $names; do
      # A service is settled when it has exactly one deployment and it is PRIMARY
      # with rolloutState COMPLETED. More than one deployment means it is mid-roll.
      local state count
      state=$(awsx ecs describe-services --cluster "$cluster" --services "$name" \
        --query 'services[0].[length(deployments),deployments[0].rolloutState,runningCount,desiredCount]' \
        --output text 2>/dev/null || printf '? ? ? ?')
      count=$(printf '%s' "$state" | awk '{print $1}')
      if [ "$count" = "1" ] && [ "$(printf '%s' "$state" | awk '{print $2}')" = "COMPLETED" ] \
         && [ "$(printf '%s' "$state" | awk '{print $3}')" = "$(printf '%s' "$state" | awk '{print $4}')" ]; then
        continue
      fi
      all_steady=0
      pending="$pending $name($(printf '%s' "$state" | awk '{print $2}') $(printf '%s' "$state" | awk '{print $3}')/$(printf '%s' "$state" | awk '{print $4}'))"
    done
    [ "$all_steady" = "1" ] && { ok "all services steady after ${elapsed}s"; return 0; }
    note "  ${elapsed}s: rolling —$pending"
    sleep 15
    elapsed=$((elapsed + 15))
  done

  die "Services did not reach steady state within ${DEPLOY_STEADY_TIMEOUT_SECONDS}s." \
    "Still rolling:$pending" \
    "The deployment may still be in progress or the circuit breaker may be rolling" \
    "it back. Check the service events and the log streams before re-running."
}

report_service_revisions() {
  local cluster="$1" svc name td
  info ""
  info "Running task definition per service:"
  for svc in api worker frontend; do
    name=$(out_map_opt ecs_service_names "$svc")
    [ -n "$name" ] || continue
    td=$(awsx ecs describe-services --cluster "$cluster" --services "$name" \
      --query 'services[0].taskDefinition' --output text 2>/dev/null || printf 'unknown')
    status_line "  $svc" "${td##*/}"
  done
}

deploy_rollback_hint() {
  [ -n "$DEPLOY_PREV_TAG" ] || return 0
  [ "$DEPLOY_SUCCEEDED" = "1" ] && return 0
  printf '\n' >&2
  hr >&2
  {
    printf '%sTO RETURN TO THE PREVIOUS IMAGE%s\n' "$C_BOLD" "$C_RESET"
    printf '\n'
    printf '  The previous tag was: %s%s%s\n' "$C_BOLD" "$DEPLOY_PREV_TAG" "$C_RESET"
    if [ -n "$DEPLOY_NEW_TAG" ]; then
      printf '  %s was written into %s.\n' "$DEPLOY_NEW_TAG" "$TFVARS"
    fi
    printf '\n'
    printf '    sed -i.bak '\''s/^image_tag *=.*/image_tag = "%s"/'\'' %s\n' "$DEPLOY_PREV_TAG" "$TFVARS"
    printf '    rm -f %s.bak\n' "$TFVARS"
    printf '    ./scripts/deploy %s %s\n' "$ENV_NAME" "$(deploy_apply_stage_name)"
    printf '\n'
    printf '  ⚠️ That reverts the IMAGE. It does not revert a migration that already\n'
    printf '     ran: Alembic downgrades are not part of this stage, and the old code\n'
    printf '     may not tolerate the new schema. Check what the migration did before\n'
    printf '     assuming the rollback is complete.\n'
  } >&2
  hr >&2
}

# Whichever phase stage the current flags permit, so this works before and after
# TLS: phase1 asserts both flags are false, phase2 requires both true.
deploy_apply_stage_name() {
  local tls cognito
  tls=$(tfvar "$TFVARS" "enable_tls" || printf '')
  cognito=$(tfvar "$TFVARS" "enable_cognito" || printf '')
  if [ "$tls" = "true" ] && [ "$cognito" = "true" ]; then
    printf 'phase2'
  else
    printf 'phase1'
  fi
}

stage_deploy() {
  banner "deploy -- ship application code to '$ENV_NAME'"
  need_cmd git; need_cmd docker; need_cmd aws; need_cmd jq; need_cmd terraform
  need_buildx
  require_domain
  require_identity "$ACCOUNT_ID"
  require_outputs "$ENV_DIR"

  # --- 1 + 2. git preflight ------------------------------------------------ #
  local branch sha
  deploy_require_clean_tree
  branch=$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null)
  sha=$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null)
  [ -n "$branch" ] && [ -n "$sha" ] || die "Could not read the git branch/SHA."
  [ "$branch" = "HEAD" ] && die "HEAD is detached." \
    "The deploy stage records the branch in the image labels, and a detached HEAD" \
    "has none. Check out the branch you mean to ship."

  deploy_require_allowed_branch "$branch"
  deploy_report_remote_divergence "$branch"

  DEPLOY_NEW_TAG="${ENV_NAME}-${sha}"
  DEPLOY_PREV_TAG=$(tfvar "$TFVARS" "image_tag" || printf '')

  local cluster taskdef container api_uri fe_uri api_repo fe_repo new_api new_fe
  cluster=$(out ecs_cluster_name)
  taskdef=$(out_map ecs_task_definition_arns migrate)
  container=$(oneoff_container_name "$taskdef")
  api_uri=$(out_map container_image_uris api)
  fe_uri=$(out_map container_image_uris frontend)
  api_repo="${api_uri%:*}"; fe_repo="${fe_uri%:*}"
  new_api="${api_repo}:${DEPLOY_NEW_TAG}"
  new_fe="${fe_repo}:${DEPLOY_NEW_TAG}"

  local netcfg
  netcfg=$(oneoff_network "$cluster")
  DEPLOY_SUBNETS=$(printf '%s' "$netcfg" | awk -F'\t' '{print $1}')
  DEPLOY_SGS=$(printf '%s' "$netcfg" | awk -F'\t' '{print $2}')

  hr
  info "  worktree    : $REPO_ROOT"
  info "  branch      : ${C_BOLD}${branch}${C_RESET}"
  info "  commit      : $sha"
  info "  new tag     : ${C_BOLD}${DEPLOY_NEW_TAG}${C_RESET}"
  info "  current tag : ${DEPLOY_PREV_TAG:-（unset）}"
  info "  apply via   : $(deploy_apply_stage_name)"
  hr

  if [ "$DEPLOY_NEW_TAG" = "$DEPLOY_PREV_TAG" ]; then
    note "The environment already references this tag. Re-running is still useful"
    note "if a previous attempt failed partway; the build will be skipped."
  fi

  # --- 3 + 4. build and push ---------------------------------------------- #
  local registry api_present=0 fe_present=0
  registry=$(uri_registry "$api_uri")
  would "aws ecr get-login-password | docker login $registry"
  awsx ecr get-login-password | docker login --username AWS --password-stdin "$registry" \
    >/dev/null || die "ECR login failed for $registry."
  ok "logged in to $registry"

  image_already_pushed "$(uri_repo "$new_api")" "$DEPLOY_NEW_TAG" && api_present=1
  image_already_pushed "$(uri_repo "$new_fe")" "$DEPLOY_NEW_TAG" && fe_present=1

  if [ "$api_present" = "1" ] && [ "$fe_present" = "1" ]; then
    ok "Both images for $DEPLOY_NEW_TAG are already in ECR -- skipping the build."
    note "  Tags are immutable, so the same commit always means the same bytes."
  fi

  # OCI labels, so a deployed image is traceable to its branch and commit without
  # consulting tfvars, git, or this script.
  local labels
  IMAGE_EXISTS_ADVICE="To ship new bytes, make a commit -- the tag is derived from HEAD."
  build_and_push "api" "$new_api" "$REPO_ROOT/backend" \
    --label "org.opencontainers.image.revision=$(git -C "$REPO_ROOT" rev-parse HEAD)" \
    --label "org.opencontainers.image.source=$branch" \
    --label "org.opencontainers.image.version=$DEPLOY_NEW_TAG"
  build_and_push "frontend" "$new_fe" "$REPO_ROOT/frontend" \
    --build-arg "NEXT_PUBLIC_API_URL=https://${DOMAIN}" \
    --label "org.opencontainers.image.revision=$(git -C "$REPO_ROOT" rev-parse HEAD)" \
    --label "org.opencontainers.image.source=$branch" \
    --label "org.opencontainers.image.version=$DEPLOY_NEW_TAG"
  IMAGE_EXISTS_ADVICE=""
  labels=""

  # --- 5. migrations, between the push and the service update -------------- #
  banner "deploy -- migrations"
  local local_heads deployed_heads
  local_heads=$(local_alembic_heads)
  info "local Alembic head(s)   : $(printf '%s' "$local_heads" | tr '\n' ' ')"
  info "reading the deployed head (one-off task on the current image)…"
  deployed_heads=$(deployed_alembic_heads "$cluster" "$taskdef" "$container") || deployed_heads=""
  info "deployed Alembic head(s): ${deployed_heads:-（none — empty database）}"

  if [ "$local_heads" = "$deployed_heads" ]; then
    ok "No new migrations in this deploy -- skipping the migration task."
    note "  The deployed database is already at the head this commit expects."
  else
    hazard "This deploy introduces schema changes. Migrating BEFORE the services roll."
    info "  Running the migration on the NEW image, via a one-off task definition"
    info "  revision -- the deployed one still points at ${DEPLOY_PREV_TAG:-the old tag}."
    confirm "Run the migration now?" || die "Aborted before migrating." \
      "The images are pushed; nothing else has changed. Re-run to continue."

    local mig_td request
    mig_td=$(register_migrate_taskdef_for_image "$taskdef" "$new_api")
    ok "registered ${mig_td##*/} (image: $DEPLOY_NEW_TAG)"

    ensure_secret_tmpdir
    request="$SECRET_TMPDIR/deploy-migrate.$$.json"
    ONEOFF_CLUSTER="$cluster" ONEOFF_TD="$mig_td" ONEOFF_CONTAINER="$container" \
    ONEOFF_SUBNETS="$DEPLOY_SUBNETS" ONEOFF_SGS="$DEPLOY_SGS" \
      jq -n '{cluster: env.ONEOFF_CLUSTER, taskDefinition: env.ONEOFF_TD,
              launchType: "FARGATE",
              networkConfiguration: {awsvpcConfiguration: {
                subnets: (env.ONEOFF_SUBNETS | split(",")),
                securityGroups: (env.ONEOFF_SGS | split(",")),
                assignPublicIp: "DISABLED"}},
              overrides: {containerOverrides: [{name: env.ONEOFF_CONTAINER,
                command: ["uv","run","alembic","upgrade","head"]}]}}' >"$request" \
      || die "Could not build the migration request."

    run_oneoff_task "deploy migration" "$request" "$cluster" "$container"
    ok "migration applied."
  fi

  # --- 6. write the tag and apply ------------------------------------------ #
  banner "deploy -- apply"
  if [ "$DEPLOY_NEW_TAG" != "$DEPLOY_PREV_TAG" ]; then
    would "sed -i: image_tag = \"$DEPLOY_NEW_TAG\" in $TFVARS"
    sed -i.bak "s|^\([[:space:]]*image_tag[[:space:]]*=[[:space:]]*\).*|\1\"${DEPLOY_NEW_TAG}\"|" "$TFVARS"
    rm -f "${TFVARS}.bak"
    local written
    written=$(tfvar "$TFVARS" "image_tag" || printf '')
    [ "$written" = "$DEPLOY_NEW_TAG" ] || die \
      "Failed to write image_tag into $TFVARS (it now reads '${written}')." \
      "Edit it by hand and re-run."
    info ""
    git -C "$REPO_ROOT" --no-pager diff -- "$TFVARS" | sed 's/^/  /'
    info ""
    ok "image_tag updated -- a tracked file, so it shows in git status."
  else
    note "image_tag already reads $DEPLOY_NEW_TAG; nothing to write."
  fi

  case "$(deploy_apply_stage_name)" in
    phase2) stage_phase2 ;;
    *) stage_phase1 ;;
  esac

  # --- 7. wait for steady state ------------------------------------------- #
  banner "deploy -- rollout"
  wait_for_services_steady "$cluster"
  report_service_revisions "$cluster"

  DEPLOY_SUCCEEDED=1
  info ""
  ok "deploy complete: $branch@$sha is live as $DEPLOY_NEW_TAG"
  info ""
  info "Verify: ./scripts/deploy $ENV_NAME status"
  info "        ./scripts/deploy $ENV_NAME smoke"
}

# --------------------------------------------------------------------------- #
# Stage: smoke
# --------------------------------------------------------------------------- #

SMOKE_FAILED=0
SMOKE_UNVERIFIED=0

http_status() {
  curl -sS -o /dev/null -w '%{http_code}' -I --max-time 20 "$1" 2>/dev/null || printf '000'
}

http_location() {
  curl -sS -o /dev/null -w '%{redirect_url}' -I --max-time 20 "$1" 2>/dev/null || printf ''
}

# A check that cannot be automated from here. Asked interactively; under --yes it
# is recorded as unverified rather than quietly passed.
manual_check() {
  local label="$1"
  if [ "${ASSUME_YES:-0}" = "1" ] || [ ! -t 0 ]; then
    warn "MANUAL  $label -- not verified (non-interactive run)"
    SMOKE_UNVERIFIED=$((SMOKE_UNVERIFIED + 1))
    return 0
  fi
  if confirm "  Did this pass?"; then
    ok "$label"
  else
    bad "$label"
    SMOKE_FAILED=$((SMOKE_FAILED + 1))
  fi
}

stage_smoke() {
  banner "smoke -- $ENV_NAME"
  need_cmd curl; need_cmd aws; need_cmd jq; need_cmd terraform
  require_domain
  require_identity "$ACCOUNT_ID"
  require_outputs "$ENV_DIR"

  local code loc bucket

  # 1 -- the front door is behind Cognito.
  info ""
  info "1. https://${DOMAIN} should 302 to Cognito"
  code=$(http_status "https://${DOMAIN}")
  if [ "$code" = "302" ]; then
    ok "1. 302 -- ALB is handing the browser to Cognito"
  elif [ "$code" = "200" ]; then
    bad "1. 200, expected 302 -- authentication is NOT applied to the default rule."
    SMOKE_FAILED=$((SMOKE_FAILED + 1))
  else
    bad "1. HTTP $code, expected 302."
    SMOKE_FAILED=$((SMOKE_FAILED + 1))
  fi

  # 2 -- the one that is a security incident rather than a test failure.
  info ""
  info "2. https://${DOMAIN}/api/v1/health should ALSO 302"
  code=$(http_status "https://${DOMAIN}/api/v1/health")
  if [ "$code" = "302" ]; then
    ok "2. 302 -- the /api/* rule carries its auth action"
  elif [ "$code" = "200" ]; then
    SMOKE_FAILED=$((SMOKE_FAILED + 1))
    info ""
    hr
    printf '%s%s  SECURITY FAILURE -- THE API IS OPEN TO THE INTERNET.%s\n' \
      "$C_BOLD" "$C_RED" "$C_RESET"
    hr
    printf '%s' "$C_RED"
    info "  /api/v1/health returned 200 instead of 302."
    info ""
    info "  This is a SECURITY FAILURE, NOT A TEST FAILURE."
    info ""
    info "  authenticate-cognito must be attached to EVERY listener rule, not just"
    info "  the default one. A 200 here means the /api/* rule is missing its auth"
    info "  action, and every API route in this environment is reachable by anyone"
    info "  on the internet, without credentials -- borrower documents, extracted"
    info "  data, the lot."
    info ""
    info "  Do not hand this environment to anyone. Do not upload a real loan file."
    info "  Fix the listener rule, re-apply, and re-run smoke before going further."
    printf '%s' "$C_RESET"
    hr
  else
    bad "2. HTTP $code, expected 302."
    SMOKE_FAILED=$((SMOKE_FAILED + 1))
  fi

  # 3 -- plain HTTP is redirected, not served.
  info ""
  info "3. http://${DOMAIN} should 301 to HTTPS"
  code=$(http_status "http://${DOMAIN}")
  loc=$(http_location "http://${DOMAIN}")
  if [ "$code" = "301" ]; then
    ok "3. 301 -> ${loc:-(no Location)}"
  else
    bad "3. HTTP $code, expected 301. Port 80 is still forwarding instead of redirecting."
    SMOKE_FAILED=$((SMOKE_FAILED + 1))
  fi

  # 4, 5 -- browser work.
  info ""
  info "4. Log in through Cognito, then through the application itself."
  info "   (Two separate logins: the ALB's, then the app's own.)"
  manual_check "4. Cognito + application login"

  info ""
  info "5. Upload one document and let it finish processing."
  manual_check "5. Document upload"

  # 6 -- the database is private; there is no route to it from here.
  info ""
  info "6. Confirm the extraction reached Bedrock. The database is in a private"
  info "   subnet with no public access, so run this where the database is"
  info "   reachable and check the result:"
  info ""
  info "     select model_used, cost_estimate, extraction_status"
  info "     from extractions order by created_at desc limit 3;"
  info ""
  info "   Expect a us.anthropic.* model with a NON-ZERO cost. A zero cost means"
  info "   the pricing table is missing that model -- extraction worked but the"
  info "   telemetry is broken, which is invisible until someone reads a bill."
  manual_check "6. Bedrock extraction with non-zero cost"

  # 7 -- documents in S3, not on a disk that vanishes.
  info ""
  bucket=$(out documents_bucket)
  info "7. Documents must be in s3://${bucket}/, not on container disk"
  local count
  count=$(awsx s3 ls "s3://${bucket}/" --recursive 2>/dev/null | grep -c . | tr -d '[:space:]') || count=0
  if [ "${count:-0}" -gt 0 ]; then
    ok "7. $count object(s) in the bucket"
    awsx s3 ls "s3://${bucket}/" --recursive 2>/dev/null | tail -5 | sed 's/^/       /' || true
  else
    bad "7. The bucket is EMPTY after an upload."
    info "     STORAGE_BACKEND is not 's3'. The application starts happily, writes"
    info "     uploaded documents to ephemeral container disk, and they vanish on"
    info "     the next task replacement -- with no error at any point."
    info "     (If check 5 was skipped, nothing has been uploaded yet and this is"
    info "     expected: upload one document, then re-run smoke.)"
    SMOKE_FAILED=$((SMOKE_FAILED + 1))
  fi

  hr
  if [ "$SMOKE_FAILED" -gt 0 ]; then
    die "smoke: $SMOKE_FAILED check(s) failed."
  fi
  if [ "$SMOKE_UNVERIFIED" -gt 0 ]; then
    warn "smoke: every automated check passed, but $SMOKE_UNVERIFIED manual check(s)"
    warn "  were not verified. Re-run interactively (without --yes) to confirm them."
    exit 2
  fi
  ok "smoke: all seven checks passed."
}

# --------------------------------------------------------------------------- #
# Stage: status -- read-only, runnable at any time, never fails the run
# --------------------------------------------------------------------------- #

status_line() { printf '  %-22s %s\n' "$1" "$2"; }

stage_status() {
  banner "status -- $ENV_NAME (account $ACCOUNT_ID, $AWS_REGION)"
  need_cmd terraform; need_cmd jq

  local have_aws=1
  command -v aws >/dev/null 2>&1 || have_aws=0
  if [ "$have_aws" = "1" ]; then
    if ! awsx sts get-caller-identity >/dev/null 2>&1; then
      warn "AWS is unreachable with profile '$AWS_PROFILE' -- probably an expired SSO"
      warn "  session. AWS-side checks below will report 'unknown'."
      have_aws=0
    fi
  fi

  # --- bootstrap ---
  local bucket="" bstate
  bucket=$(grep -E '^[[:space:]]*bucket[[:space:]]*=' "$ENV_DIR/backend.tf" 2>/dev/null \
    | head -1 | sed -E 's/.*=[[:space:]]*"([^"]*)".*/\1/' || printf '')
  if [ -z "$bucket" ]; then
    bstate="no backend.tf -- this environment uses LOCAL state"
  elif [ "$have_aws" = "0" ]; then
    bstate="unknown (no AWS access)"
  elif awsx s3api head-bucket --bucket "$bucket" >/dev/null 2>&1; then
    bstate="ok -- s3://$bucket exists"
  else
    bstate="MISSING -- s3://$bucket not reachable; run: deploy $ENV_NAME bootstrap"
  fi
  status_line "bootstrap" "$bstate"

  # --- phase1 / outputs ---
  if load_outputs "$ENV_DIR"; then
    local n
    n=$(jq -r 'length' "$TF_OUTPUT_CACHE")
    status_line "phase1" "applied -- $n terraform outputs available"
  else
    status_line "phase1" "not applied (no outputs); everything below is unknown"
    hr
    info "Next:  ./scripts/deploy $ENV_NAME phase1"
    return 0
  fi

  # --- phase flags ---
  status_line "phase flags" "enable_tls=$(tfvar "$TFVARS" enable_tls || echo '?')  enable_cognito=$(tfvar "$TFVARS" enable_cognito || echo '?')"

  local cert
  cert=$(out_opt certificate_arn)
  if [ -n "$cert" ]; then
    status_line "phase2 (TLS)" "certificate present"
  else
    status_line "phase2 (TLS)" "no certificate -- phase 2 not applied"
  fi

  # --- dns ---
  if [ -n "$DOMAIN" ] && command -v dig >/dev/null 2>&1; then
    local c
    c=$(ns_awsdns_count "$DOMAIN")
    if [ "$c" -ge 4 ]; then
      status_line "dns" "delegated -- $c AWS nameservers for $DOMAIN"
    else
      status_line "dns" "NOT delegated -- $c/4 for $DOMAIN; run: deploy $ENV_NAME dns"
    fi
  else
    status_line "dns" "n/a (no domain_name, or dig not installed)"
  fi

  # --- deployed code vs this worktree ---
  # "Is staging running my latest commit" answered at a glance. The deployed tag
  # comes from what the API service is RUNNING, not from tfvars: tfvars is the
  # desired state and can be ahead of a failed or in-flight apply.
  local running_td running_image running_tag wt_branch wt_sha wt_dirty expected
  wt_branch=$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || printf '?')
  wt_sha=$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || printf '?')
  wt_dirty=$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null | grep -c . | tr -d '[:space:]')
  expected="${ENV_NAME}-${wt_sha}"

  running_tag=""
  if [ "$have_aws" = "1" ]; then
    running_td=$(awsx ecs describe-services --cluster "$(out_opt ecs_cluster_name)" \
      --services "$(out_map_opt ecs_service_names api)" \
      --query 'services[0].taskDefinition' --output text 2>/dev/null || printf '')
    if [ -n "$running_td" ] && [ "$running_td" != "None" ]; then
      running_image=$(awsx ecs describe-task-definition --task-definition "$running_td" \
        --query 'taskDefinition.containerDefinitions[0].image' --output text 2>/dev/null || printf '')
      running_tag="${running_image##*:}"
    fi
  fi

  status_line "deployed tag" "${running_tag:-unknown (no AWS access)}"
  status_line "desired tag (tfvars)" "$(tfvar "$TFVARS" image_tag || echo '?')"
  status_line "worktree" "$REPO_ROOT"
  status_line "worktree branch/sha" "${wt_branch}@${wt_sha}$([ "${wt_dirty:-0}" != "0" ] && printf ' (+%s uncommitted)' "$wt_dirty")"

  # The branch label is read from the image itself, so it is true even if tfvars
  # or the working tree have since moved.
  local deployed_branch=""
  if [ -n "$running_tag" ] && command -v docker >/dev/null 2>&1 \
     && docker buildx version >/dev/null 2>&1 && [ -n "${running_image:-}" ]; then
    deployed_branch=$(docker buildx imagetools inspect "$running_image" \
      --format '{{ index .Image.Config.Labels "org.opencontainers.image.source" }}' 2>/dev/null || printf '')
  fi
  case "$deployed_branch" in
    "" | "<no value>" | "null") status_line "deployed branch label" "unknown (pre-label image, or no registry access)" ;;
    *) status_line "deployed branch label" "$deployed_branch" ;;
  esac

  if [ -z "$running_tag" ]; then
    status_line "in sync?" "unknown"
  elif [ "$running_tag" = "$expected" ] && [ "${wt_dirty:-0}" = "0" ]; then
    status_line "in sync?" "YES -- staging is running this worktree's HEAD"
  elif [ "$running_tag" = "$expected" ]; then
    status_line "in sync?" "HEAD matches, but the worktree has uncommitted changes"
  else
    status_line "in sync?" "NO -- deployed $running_tag, this worktree would ship $expected"
  fi

  # --- images ---
  local kind uri repo tag
  for kind in api frontend; do
    uri=$(out_map_opt container_image_uris "$kind")
    if [ -z "$uri" ]; then status_line "image:$kind" "unknown"; continue; fi
    repo=$(uri_repo "$uri"); tag=$(uri_tag "$uri")
    if [ "$have_aws" = "0" ]; then
      status_line "image:$kind" "unknown (no AWS access) -- $repo:$tag"
    elif awsx ecr describe-images --repository-name "$repo" --image-ids "imageTag=$tag" >/dev/null 2>&1; then
      status_line "image:$kind" "pushed -- $repo:$tag"
    else
      status_line "image:$kind" "MISSING -- $repo:$tag not in ECR; run: deploy $ENV_NAME images"
    fi
  done

  # --- secrets ---
  local names key id len
  names=$(jq -r '.secret_names.value | keys[]' "$TF_OUTPUT_CACHE" 2>/dev/null || printf '')
  if [ -z "$names" ]; then
    status_line "secrets" "unknown (no secret_names output)"
  elif [ "$have_aws" = "0" ]; then
    status_line "secrets" "unknown (no AWS access)"
  else
    for key in $names; do
      id=$(out_map secret_names "$key")
      len=$(secret_len "$id")
      if [ -n "$len" ]; then
        status_line "secret:$key" "populated ($len bytes)"
      else
        status_line "secret:$key" "EMPTY -- tasks using it cannot start"
      fi
    done
  fi

  # --- migration ---
  # The database is private, so alembic_version cannot be read from here. The
  # observable proxy is the most recent migrate task ECS still remembers; stopped
  # tasks age out of the API after about an hour, so "unknown" is common and does
  # not mean "not migrated".
  local cluster mig_family last
  if [ "$have_aws" = "1" ]; then
    cluster=$(out_opt ecs_cluster_name)
    mig_family=$(out_map_opt ecs_task_definition_arns migrate)
    mig_family="${mig_family##*/}"; mig_family="${mig_family%:*}"
    if [ -n "$cluster" ] && [ -n "$mig_family" ]; then
      last=$(awsx ecs list-tasks --cluster "$cluster" --family "$mig_family" \
        --desired-status STOPPED --query 'taskArns[-1]' --output text 2>/dev/null || printf 'None')
      if [ -n "$last" ] && [ "$last" != "None" ]; then
        local ec
        ec=$(awsx ecs describe-tasks --cluster "$cluster" --tasks "$last" \
          --query 'tasks[0].containers[0].exitCode' --output text 2>/dev/null || printf '?')
        if [ "$ec" = "0" ]; then
          status_line "migration" "last migrate task exited 0"
        else
          status_line "migration" "last migrate task exited $ec -- check its logs"
        fi
      else
        status_line "migration" "unknown -- no recent migrate task (they age out ~1h)"
      fi
    else
      status_line "migration" "unknown"
    fi
  else
    status_line "migration" "unknown (no AWS access)"
  fi

  # --- services ---
  if [ "$have_aws" = "1" ]; then
    local svc name running desired
    cluster=$(out_opt ecs_cluster_name)
    for svc in api worker frontend; do
      name=$(out_map_opt ecs_service_names "$svc")
      [ -n "$name" ] || continue
      running=$(awsx ecs describe-services --cluster "$cluster" --services "$name" \
        --query 'services[0].[runningCount,desiredCount]' --output text 2>/dev/null || printf '?	?')
      desired=$(printf '%s' "$running" | awk -F'\t' '{print $2}')
      running=$(printf '%s' "$running" | awk -F'\t' '{print $1}')
      if [ "$running" = "$desired" ] && [ "$running" != "0" ] && [ "$running" != "?" ]; then
        status_line "service:$svc" "healthy -- $running/$desired running"
      else
        status_line "service:$svc" "$running/$desired running -- check the log stream, not ECS events"
      fi
    done
  else
    status_line "services" "unknown (no AWS access)"
  fi

  # --- url ---
  local url
  url=$(out_opt application_url)
  [ -n "$url" ] && status_line "url" "$url"

  hr
  info "status is read-only. Nothing above was changed."
  return 0
}

# --------------------------------------------------------------------------- #
# Stage: all
# --------------------------------------------------------------------------- #

stage_all() {
  banner "all -- full sequence for $ENV_NAME"
  # Checked here rather than only inside `dns`: `all` consults delegation itself
  # to decide whether to pause, and a missing dig would read as "not delegated".
  need_cmd dig
  info "Order: bootstrap -> phase1 -> dns -> images -> secrets -> migrate ->"
  info "       phase2 -> smoke"
  info ""
  note "Each stage is individually idempotent, so re-running \`all\` after a manual"
  note "step picks up where it stopped rather than repeating work."

  stage_bootstrap
  stage_phase1

  # The one genuinely manual gate. Rather than block for up to 30 minutes inside
  # `all`, check once and hand the sequence back to the operator.
  require_domain
  local count
  count=$(ns_awsdns_count "$DOMAIN")
  if [ "$count" -lt 4 ]; then
    banner "all -- PAUSED at the manual delegation step"
    stage_dns_instructions_only
    hr
    info "${C_BOLD}The sequence stops here.${C_RESET} Add the NS records at the registrar,"
    info "then continue with:"
    info ""
    info "    ./scripts/deploy $ENV_NAME all"
    info ""
    info "(or watch the delegation land first with: ./scripts/deploy $ENV_NAME dns)"
    hr
    return 0
  fi
  ok "delegation already live -- continuing."

  stage_images
  stage_secrets
  stage_migrate
  stage_phase2
  stage_smoke
}

# The instruction half of `dns`, without the polling loop -- used by `all`.
stage_dns_instructions_only() {
  require_outputs "$ENV_DIR"
  local parent="${DOMAIN#*.}"
  info "Add these FOUR NS records at the registrar for ${C_BOLD}${parent}${C_RESET}:"
  info ""
  info "  Type: NS     Host: ${C_BOLD}${DOMAIN%%.*}${C_RESET}"
  info ""
  out_list route53_name_servers | sed 's/^/       /'
  info ""
  info "Namecheap: Domain List -> ${parent} -> Manage -> Advanced DNS -> Add New"
  info "Record -> NS Record, four times, one nameserver each."
  hazard "The apex ${parent} stays at the registrar and is never delegated."
}

# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #

main() {
  parse_args "$@"
  resolve_env

  case "$STAGE" in
    bootstrap) stage_bootstrap ;;
    phase1)    stage_phase1 ;;
    dns)       stage_dns ;;
    images)    stage_images ;;
    secrets)   stage_secrets ;;
    migrate)   stage_migrate ;;
    phase2)    stage_phase2 ;;
    smoke)     stage_smoke ;;
    all)       stage_all ;;
    status)    stage_status ;;
    bootstrap-admin) stage_bootstrap_admin ;;
    add-user)  stage_add_user ;;
    query-setup) stage_query_setup ;;
    query)     stage_query ;;
    deploy)    stage_deploy ;;
    *)         die "Unhandled stage: $STAGE" ;;
  esac
}

main "$@"
