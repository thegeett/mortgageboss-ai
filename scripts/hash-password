#!/usr/bin/env bash
# Hash a password locally, print ONLY the hash.
#
# The provisioning scripts (app.scripts.bootstrap_admin, app.scripts.add_user)
# take a bcrypt HASH, never a password, because the value travels through
# `aws ecs run-task --overrides`: visible in `describe-tasks` for about an hour
# and recorded in the CloudTrail RunTask event. Hashing here means the plaintext
# never leaves this machine.
#
# ⚠️ THE PASSWORD MUST NOT REACH ARGV, HISTORY, OR THE SCREEN.
#   * read -s: no echo, and no shell history because it is input, not a command.
#   * The password goes to python on STDIN, never as an argument -- `ps` shows
#     the full command line of a running process to every user on the machine.
#   * printf is a shell builtin, so it does not fork a process carrying the value.
#   * Nothing is written to disk at any point.
#
# It calls the application's OWN hash_password and validate_password_strength,
# not a reimplementation, so the hash is by construction one that
# `authenticate_user` will verify and the policy is the one the app enforces.
#
# Usage:
#   ./scripts/hash-password                 # prompts, prints the hash
#   HASH=$(./scripts/hash-password)         # capture it (prompt goes to stderr)

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
BACKEND="$REPO_ROOT/backend"
PY="$BACKEND/.venv/bin/python"

if [ ! -x "$PY" ]; then
  printf 'ERROR: %s not found.\n' "$PY" >&2
  printf 'The hash must come from the application'\''s own bcrypt, so this needs the\n' >&2
  printf 'backend virtualenv:  cd backend && uv sync\n' >&2
  exit 1
fi

# Every prompt goes to STDERR so `HASH=$(./scripts/hash-password)` captures the
# hash and nothing else.
password=""
confirm=""
if [ -t 0 ]; then
  printf 'Password: ' >&2
  read -r -s password
  printf '\n' >&2
  printf 'Confirm:  ' >&2
  read -r -s confirm
  printf '\n' >&2
  if [ "$password" != "$confirm" ]; then
    printf 'ERROR: passwords do not match. Nothing was hashed.\n' >&2
    exit 1
  fi
else
  # Non-interactive: read one line from stdin. For automation only -- whatever
  # feeds it is then responsible for keeping the password off argv.
  IFS= read -r password || true
fi

if [ -z "$password" ]; then
  printf 'ERROR: empty password. Nothing was hashed.\n' >&2
  exit 1
fi

# The password crosses into python on stdin. cd into backend so `app` imports.
printf '%s' "$password" | (
  cd "$BACKEND" && "$PY" -c '
import sys
from app.core.security import PasswordPolicyError, hash_password, validate_password_strength

password = sys.stdin.read()
try:
    validate_password_strength(password)
except PasswordPolicyError as exc:
    sys.stderr.write(f"ERROR: {exc}\n")
    raise SystemExit(1) from None

# stdout carries the hash and nothing else -- no trailing newline, so
# HASH=$(...) is exactly 60 characters.
sys.stdout.write(hash_password(password))
'
)

password=""
confirm=""
