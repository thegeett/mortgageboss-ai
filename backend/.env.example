# Application
APP_NAME=mortgageboss-ai
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Database (PostgreSQL with asyncpg driver)
# Use the credentials from docker-compose.yml for local development
DATABASE_URL=postgresql+asyncpg://mortgageboss:mortgageboss_dev_password@localhost:5432/mortgageboss_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis (for Celery broker and caching)
REDIS_URL=redis://localhost:6379/0

# Celery (LP-41) — background task queue. Broker + result backend default to REDIS_URL
# (the line above), so normally you don't set these. Override only to point Celery at a
# different Redis (e.g. a dedicated broker in production):
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Anthropic API (LP-37)
# REQUIRED for AI features (classification LP-38, extraction LP-39). The app refuses
# to start without it; the missing-key error for an actual AI *call* fires at call time.
# Tests mock the client, so they never make a real call (CI uses a dummy value).
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here  # pragma: allowlist secret
# Model identifiers — CONFIGURATION to VERIFY against current Anthropic docs (they change).
# These are the intended production/staging values and match the code defaults. Sonnet is the
# deliberate extraction tier (cost + retention safety); set it to claude-opus-4-8 only for a
# considered opt-in to Opus — do NOT reintroduce Opus by copying a stale example.
ANTHROPIC_MODEL_CLASSIFICATION=claude-haiku-4-5
ANTHROPIC_MODEL_EXTRACTION=claude-sonnet-4-5
# AI retry policy: transient failures (429/5xx/connection) retried with backoff+jitter.
AI_MAX_RETRIES=3
AI_BASE_RETRY_DELAY_SECONDS=1.0

# JWT / Authentication
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-real-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Application-level PII encryption (LP-14)
# Fernet key for encrypting sensitive PII (e.g. borrower SSN) at rest. The key
# lives here, never in the database, so a database-only compromise yields only
# ciphertext. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-real-fernet-key-44-url-safe-base64-chars=  # pragma: allowlist secret

# CORS
# JSON array of allowed origins
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# File Storage (LP-35)
# Where uploaded document BYTES live (the Document row stores only a storage_path).
# STORAGE_BACKEND selects the backend: "local" (dev) or "s3" (production, Phase 7).
# STORAGE_LOCAL_PATH is the local filesystem root for the "local" backend; it MUST be
# outside any web-served/static directory (files are served only via the auth'd
# download endpoint) and is gitignored — do not commit stored documents.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# S3 storage (C0) — read ONLY when STORAGE_BACKEND=s3. Leave blank for local dev.
# On Fargate the API and the worker are separate tasks on separate hosts with NO
# shared filesystem, so object storage is required there, not optional.
# S3_BUCKET is REQUIRED when STORAGE_BACKEND=s3 — the app refuses to start without it.
# S3_ENDPOINT_URL is for MinIO/LocalStack only; leave blank for real AWS.
# S3_KMS_KEY_ID set => SSE-KMS with that key; blank => SSE-S3 (AES256).
# S3_REGION blank => us-east-1 (never an empty region name, which botocore rejects).
# S3_PRESIGN_EXPIRY_SECONDS blank => 900. Blanking it must never block startup, least
# of all under STORAGE_BACKEND=local, where it is not read at all.
#
# There are deliberately NO AWS key/secret settings. Credentials come from the default
# provider chain: SSO or a profile locally, the task role on ECS. Do not add them.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_PRESIGN_EXPIRY_SECONDS=900
S3_KMS_KEY_ID=

# Email (SMTP - points to MailHog in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@mortgageboss.ai
SMTP_FROM_NAME=mortgageboss-ai

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
